---
interface Props {
  agency: string;
  phone: string;
  icon?: 'phone' | 'shield' | 'fire' | 'police' | 'cross' | string;
  color?: 'red' | 'emerald' | 'amber' | 'blue' | 'rose' | string;
  typeBadge?: string;
}

const {
  agency,
  phone,
  icon = "phone",
  color = "red",
  typeBadge
} = Astro.props;

const colorStyles = {
  red: {
    badge: 'bg-red-50 text-red-600 border-red-100',
    number: 'text-red-600 hover:text-red-700',
    typeTag: 'bg-red-100/70 text-red-700',
    btn: 'bg-red-600 hover:bg-red-700 text-white shadow-xs hover:shadow-sm',
  },
  emerald: {
    badge: 'bg-emerald-50 text-emerald-600 border-emerald-100',
    number: 'text-emerald-700 hover:text-emerald-800',
    typeTag: 'bg-emerald-100/70 text-emerald-700',
    btn: 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-xs hover:shadow-sm',
  },
  amber: {
    badge: 'bg-amber-50 text-amber-600 border-amber-100',
    number: 'text-amber-700 hover:text-amber-800',
    typeTag: 'bg-amber-100/70 text-amber-800',
    btn: 'bg-amber-600 hover:bg-amber-700 text-white shadow-xs hover:shadow-sm',
  },
  blue: {
    badge: 'bg-blue-50 text-blue-600 border-blue-100',
    number: 'text-blue-700 hover:text-blue-800',
    typeTag: 'bg-blue-100/70 text-blue-700',
    btn: 'bg-blue-600 hover:bg-blue-700 text-white shadow-xs hover:shadow-sm',
  },
  rose: {
    badge: 'bg-rose-50 text-rose-600 border-rose-100',
    number: 'text-rose-700 hover:text-rose-800',
    typeTag: 'bg-rose-100/70 text-rose-700',
    btn: 'bg-rose-600 hover:bg-rose-700 text-white shadow-xs hover:shadow-sm',
  },
};

const style = colorStyles[color as keyof typeof colorStyles] || colorStyles.red;
const cleanPhone = phone.replace(/[^0-9]/g, '');

// Auto-detect phone type badge if not passed explicitly
let detectedType = typeBadge;
if (!detectedType) {
  if (phone.length <= 4) {
    detectedType = 'Shortcode 24/7';
  } else if (phone.startsWith('(062)') || phone.startsWith('062')) {
    detectedType = 'Zamboanga Landline';
  } else if (phone.startsWith('09')) {
    detectedType = 'Mobile Hotline';
  } else {
    detectedType = 'Direct Hotline';
  }
}
---

<div class="bg-white border border-slate-200/80 hover:border-slate-300 shadow-sm hover:shadow-md transition-all rounded-3xl p-5 flex flex-col items-center text-center justify-between group h-full relative overflow-hidden">
  
  <div class="w-full flex flex-col items-center">
    <!-- Network Type Badge -->
    <span class={`px-2.5 py-0.5 rounded-full text-[10px] font-bold tracking-wider uppercase mb-3 ${style.typeTag}`}>
      {detectedType}
    </span>

    <!-- Icon Badge -->
    <div class={`w-12 h-12 rounded-2xl flex items-center justify-center mb-3 border ${style.badge} group-hover:scale-110 transition-transform duration-200 shadow-2xs`}>
      {icon === 'phone' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
        </svg>
      )}

      {icon === 'shield' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
        </svg>
      )}

      {icon === 'fire' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z" />
        </svg>
      )}

      {icon === 'police' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
      )}

      {icon === 'cross' && (
        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
        </svg>
      )}
    </div>

    <!-- Agency Name -->
    <div class="text-[11px] font-extrabold text-slate-500 uppercase tracking-wider mb-3 leading-tight">
      {agency}
    </div>
  </div>

  <!-- Phone Display & Interactive Actions -->
  <div class="w-full flex flex-col items-center gap-2.5 mt-1">
    <!-- Monospace Number Display with Copy Trigger -->
    <div class="flex items-center justify-center gap-1.5 bg-slate-50 border border-slate-100 rounded-xl px-3 py-1.5 w-full">
      <span class="text-base sm:text-lg font-black font-mono tracking-tight text-slate-900 select-all">
        {phone}
      </span>
      <button
        type="button"
        data-copy-phone={phone}
        class="copy-phone-btn text-slate-400 hover:text-blue-600 transition-colors p-1 rounded-md hover:bg-slate-200/60 focus:outline-none focus:ring-1 focus:ring-blue-500 shrink-0"
        title="Copy phone number"
        aria-label={`Copy ${phone}`}
      >
        <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
        </svg>
        <svg class="w-4 h-4 check-icon hidden text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
        </svg>
      </button>
    </div>

    <!-- Primary Call Button -->
    <a
      href={`tel:${cleanPhone || phone}`}
      class={`w-full py-2 px-3 rounded-xl font-bold text-xs flex items-center justify-center gap-1.5 transition-all ${style.btn} focus:outline-none focus:ring-2 focus:ring-offset-1`}
      aria-label={`Call ${agency} at ${phone}`}
    >
      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
      </svg>
      <span>Call Now</span>
    </a>
  </div>
</div>

