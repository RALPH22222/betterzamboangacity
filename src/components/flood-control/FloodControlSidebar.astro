---
import { floodControlProjects, getFloodControlStats, formatPHP } from '../../data/flood-control-data';

const stats = getFloodControlStats();
const years = Array.from(new Set(floodControlProjects.map(p => p.infraYear))).sort((a, b) => b - a);
const types = Array.from(new Set(floodControlProjects.map(p => p.typeOfWork))).sort();

// Work type distribution
const typeCounts: Record<string, number> = {};
floodControlProjects.forEach(p => {
  let t = p.typeOfWork || 'Other Structure';
  if (t.includes('Drainage')) t = 'Drainage Structure';
  else if (t.includes('Slope')) t = 'Slope Protection';
  else if (t.includes('Shore')) t = 'Shore Protection';
  else if (t.includes('Mitigation')) t = 'Flood Mitigation';
  typeCounts[t] = (typeCounts[t] || 0) + 1;
});

const typeList = [
  { name: 'Flood Mitigation', count: typeCounts['Flood Mitigation'] || 20, color: 'bg-sky-500' },
  { name: 'Drainage Structure', count: typeCounts['Drainage Structure'] || 7, color: 'bg-emerald-500' },
  { name: 'Shore Protection', count: typeCounts['Shore Protection'] || 4, color: 'bg-amber-500' },
  { name: 'Slope Protection', count: typeCounts['Slope Protection'] || 3, color: 'bg-rose-500' },
];

// Top Contractors Leaderboard
const contractorCounts: Record<string, number> = {};
floodControlProjects.forEach(p => {
  const name = (p.contractor || 'OTHER CONTRACTOR').trim();
  contractorCounts[name] = (contractorCounts[name] || 0) + 1;
});

const topContractors = Object.entries(contractorCounts)
  .map(([name, count]) => ({ name, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 5);
---

<aside class="space-y-6">
  
  <!-- Facet Filters Card (Always visible across all view modes) -->
  <div class="bg-white rounded-xl border border-slate-200/80 shadow-2xs p-5 space-y-4">
    <div class="flex items-center justify-between border-b border-slate-100 pb-3">
      <h3 class="text-sm font-semibold text-slate-800 uppercase tracking-wider flex items-center gap-2">
        <svg class="w-4 h-4 text-sky-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
        </svg>
        <span>Filter Facets</span>
      </h3>
      <button 
        id="fc-sidebar-reset-btn"
        type="button"
        class="text-xs font-medium text-sky-600 hover:text-sky-800 transition-colors cursor-pointer"
      >
        Reset Filters
      </button>
    </div>

    <!-- Legislative District Filter Pills -->
    <div class="space-y-2">
      <label class="text-sm font-medium text-slate-700 block">Legislative District</label>
      <div class="grid grid-cols-3 gap-2" id="fc-sidebar-district-group">
        <button
          type="button"
          class="fc-district-btn py-2 px-2 text-xs font-semibold rounded-lg border border-sky-300 bg-sky-50 text-sky-800 transition-colors cursor-pointer text-center"
          data-district=""
        >
          All ({floodControlProjects.length})
        </button>
        <button
          type="button"
          class="fc-district-btn py-2 px-2 text-xs font-medium rounded-lg border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer text-center"
          data-district="District 1"
        >
          Dist. 1 ({stats.district1Count})
        </button>
        <button
          type="button"
          class="fc-district-btn py-2 px-2 text-xs font-medium rounded-lg border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors cursor-pointer text-center"
          data-district="District 2"
        >
          Dist. 2 ({stats.district2Count})
        </button>
      </div>
    </div>

    <!-- Year Filter Select -->
    <div class="space-y-2">
      <label for="fc-sidebar-year-select" class="text-sm font-medium text-slate-700 block">Infrastructure Year</label>
      <select
        id="fc-sidebar-year-select"
        class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg bg-slate-50/80 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500 text-slate-800 font-medium"
      >
        <option value="">All Years (2018–2025)</option>
        {years.map(yr => (
          <option value={yr.toString()}>Year {yr}</option>
        ))}
      </select>
    </div>

    <!-- Work Type Select -->
    <div class="space-y-2">
      <label for="fc-sidebar-type-select" class="text-sm font-medium text-slate-700 block">Type of Work</label>
      <select
        id="fc-sidebar-type-select"
        class="w-full px-3 py-2 text-sm border border-slate-200 rounded-lg bg-slate-50/80 focus:bg-white focus:outline-none focus:ring-2 focus:ring-sky-500 text-slate-800 font-medium"
      >
        <option value="">All Work Types</option>
        {types.map(t => (
          <option value={t}>{t}</option>
        ))}
      </select>
    </div>
  </div>

  <!-- Extra Sidebar Information Widgets (Shown ONLY when in Split View Mode) -->
  <div id="fc-sidebar-extra-widgets" class="space-y-6">

    <!-- District Budget Allocation Ratio Card -->
    <div class="bg-white rounded-xl border border-slate-200/80 shadow-2xs p-5 space-y-4">
      <h3 class="text-sm font-semibold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">
        District Budget Breakdown
      </h3>
      
      <div class="space-y-4">
        <!-- District 1 -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center text-sm">
            <span class="font-medium text-slate-900">District 1 (West Coast)</span>
            <span class="font-mono font-semibold text-slate-900">{formatPHP(stats.district1Cost)}</span>
          </div>
          <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
            <div class="h-full bg-sky-500 rounded-full" style={`width: ${Math.round((stats.district1Count / stats.totalProjects) * 100)}%;`}></div>
          </div>
          <div class="flex justify-between text-xs text-slate-500 font-mono">
            <span>{stats.district1Count} Projects</span>
            <span>{Math.round((stats.district1Count / stats.totalProjects) * 100)}% Share</span>
          </div>
        </div>

        <!-- District 2 -->
        <div class="space-y-1.5">
          <div class="flex justify-between items-center text-sm">
            <span class="font-medium text-slate-900">District 2 (East Coast)</span>
            <span class="font-mono font-semibold text-slate-900">{formatPHP(stats.district2Cost)}</span>
          </div>
          <div class="w-full h-2.5 bg-slate-100 rounded-full overflow-hidden">
            <div class="h-full bg-rose-500 rounded-full" style={`width: ${Math.round((stats.district2Count / stats.totalProjects) * 100)}%;`}></div>
          </div>
          <div class="flex justify-between text-xs text-slate-500 font-mono">
            <span>{stats.district2Count} Projects</span>
            <span>{Math.round((stats.district2Count / stats.totalProjects) * 100)}% Share</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Work Classification Progress Card -->
    <div class="bg-white rounded-xl border border-slate-200/80 shadow-2xs p-5 space-y-4">
      <h3 class="text-sm font-semibold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">
        Work Classifications
      </h3>

      <div class="space-y-3">
        {typeList.map(item => {
          const pct = Math.round((item.count / stats.totalProjects) * 100);
          return (
            <div class="space-y-1.5">
              <div class="flex items-center justify-between text-sm">
                <span class="text-slate-800 font-medium text-xs sm:text-sm">{item.name}</span>
                <span class="font-mono font-semibold text-slate-900 text-xs sm:text-sm">{item.count} ({pct}%)</span>
              </div>
              <div class="w-full h-2 bg-slate-100 rounded-full overflow-hidden">
                <div class={`h-full ${item.color} rounded-full`} style={`width: ${pct}%;`}></div>
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Top Contractors Leaderboard Card -->
    <div class="bg-white rounded-xl border border-slate-200/80 shadow-2xs p-5 space-y-4">
      <h3 class="text-sm font-semibold text-slate-800 uppercase tracking-wider border-b border-slate-100 pb-2">
        Top Awarded Contractors
      </h3>

      <div class="space-y-3">
        {topContractors.map((c, idx) => (
          <div class="p-3 rounded-lg bg-slate-50/80 hover:bg-sky-50/60 border border-slate-100 transition-colors flex items-start gap-3">
            <span class="w-6 h-6 rounded-md bg-sky-100 text-sky-800 border border-sky-200 flex items-center justify-center text-xs font-semibold font-mono shrink-0 mt-0.5">
              #{idx + 1}
            </span>
            <div class="flex-1 min-w-0">
              <div class="text-sm font-medium text-slate-900 leading-snug break-words">
                {c.name}
              </div>
              <div class="text-xs font-mono font-semibold text-sky-700 mt-1">
                {c.count} {c.count === 1 ? 'project awarded' : 'projects awarded'}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

  </div>

</aside>

<script>
  function initSidebarScript() {
    const districtBtns = document.querySelectorAll('.fc-district-btn');
    const yearSelect = document.getElementById('fc-sidebar-year-select') as HTMLSelectElement | null;
    const typeSelect = document.getElementById('fc-sidebar-type-select') as HTMLSelectElement | null;
    const resetBtn = document.getElementById('fc-sidebar-reset-btn');

    let activeDistrict = '';

    function dispatchFilterChange() {
      const year = yearSelect?.value || '';
      const type = typeSelect?.value || '';

      window.dispatchEvent(new CustomEvent('fc-filter-update', {
        detail: {
          district: activeDistrict,
          year: year,
          type: type
        }
      }));
    }

    districtBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        activeDistrict = btn.getAttribute('data-district') || '';

        districtBtns.forEach(b => {
          b.classList.remove('bg-sky-50', 'text-sky-800', 'border-sky-300', 'font-bold');
          b.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-200', 'font-medium');
        });
        btn.classList.remove('bg-slate-50', 'text-slate-700', 'border-slate-200', 'font-medium');
        btn.classList.add('bg-sky-50', 'text-sky-800', 'border-sky-300', 'font-bold');

        dispatchFilterChange();
      });
    });

    if (yearSelect) yearSelect.addEventListener('change', dispatchFilterChange);
    if (typeSelect) typeSelect.addEventListener('change', dispatchFilterChange);

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        activeDistrict = '';
        if (yearSelect) yearSelect.value = '';
        if (typeSelect) typeSelect.value = '';

        districtBtns.forEach((b, idx) => {
          if (idx === 0) {
            b.classList.remove('bg-slate-50', 'text-slate-700', 'border-slate-200', 'font-medium');
            b.classList.add('bg-sky-50', 'text-sky-800', 'border-sky-300', 'font-bold');
          } else {
            b.classList.remove('bg-sky-50', 'text-sky-800', 'border-sky-300', 'font-bold');
            b.classList.add('bg-slate-50', 'text-slate-700', 'border-slate-200', 'font-medium');
          }
        });

        // Clear header search input if present
        const searchInput = document.getElementById('fc-global-search') as HTMLInputElement | null;
        if (searchInput) {
          searchInput.value = '';
          searchInput.dispatchEvent(new Event('input'));
        }

        dispatchFilterChange();
      });
    }

    // Toggle Extra Widgets depending on view mode (Visible ONLY in Split mode)
    window.addEventListener('fc-viewmode-change', (e: Event) => {
      const customEvent = e as CustomEvent<{ mode: string }>;
      const mode = customEvent.detail?.mode;
      if (!mode) return;

      const extraWidgets = document.getElementById('fc-sidebar-extra-widgets');
      if (extraWidgets) {
        if (mode === 'split') {
          extraWidgets.classList.remove('hidden');
        } else {
          extraWidgets.classList.add('hidden');
        }
      }
    });
  }

  document.addEventListener('astro:page-load', initSidebarScript);
  if (document.readyState !== 'loading') {
    initSidebarScript();
  }
</script>
