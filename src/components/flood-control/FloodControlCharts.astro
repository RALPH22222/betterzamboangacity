            <!-- Flat Rectangular Column Bars -->
            <div class="relative z-10 flex items-end justify-between h-full px-1 gap-2">
              {yearsList.map(yr => {
                const data = yearData[yr] || { count: 0, cost: 0 };
                const count = data.count;
