                    <span class="font-semibold text-sky-700">{c.count} {c.count === 1 ? 'project' : 'projects'}</span>
                    <span class="text-slate-600 font-medium">{formatPHP(c.cost)}</span>
                  </div>
                </div>
                <div class="w-full h-2 bg-slate-200/70 rounded-none overflow-hidden">
                  <div
                    class={`h-full ${c.barClass} rounded-none`}
                    style={`width: ${pct}%;`}
                  ></div>
                </div>
              </div>
