---
import { floodControlProjects, formatPHP } from '../../data/flood-control-data';

// Helper for compact currency formatting in charts
function formatCompactPHP(val: number): string {
  if (!val || isNaN(val)) return '₱0';
  if (val >= 1_000_000_000) return `₱${(val / 1_000_000_000).toFixed(2)}B`;
  if (val >= 1_000_000) return `₱${(val / 1_000_000).toFixed(1)}M`;
  if (val >= 1_000) return `₱${(val / 1_000).toFixed(0)}K`;
  return `₱${val.toFixed(0)}`;
}

// 0. Approved Budget (ABC) vs Project Cost Overall & Yearly
let totalABC = 0;
let totalContractCost = 0;

const budgetVsCostByYear: Record<number, { abc: number; cost: number; count: number }> = {
  2018: { abc: 0, cost: 0, count: 0 },
  2019: { abc: 0, cost: 0, count: 0 },
  2020: { abc: 0, cost: 0, count: 0 },
  2021: { abc: 0, cost: 0, count: 0 },
  2022: { abc: 0, cost: 0, count: 0 },
  2023: { abc: 0, cost: 0, count: 0 },
  2024: { abc: 0, cost: 0, count: 0 },
  2025: { abc: 0, cost: 0, count: 0 },
};

floodControlProjects.forEach(p => {
  const abcVal = p.abc || 0;
  const costVal = p.contractCost || 0;
  totalABC += abcVal;
  totalContractCost += costVal;

  const y = p.infraYear || 2023;
  if (budgetVsCostByYear[y]) {
    budgetVsCostByYear[y].abc += abcVal;
    budgetVsCostByYear[y].cost += costVal;
    budgetVsCostByYear[y].count += 1;
  }
});

const totalVariance = totalABC - totalContractCost;
const totalSavingsPct = totalABC > 0 ? (totalVariance / totalABC) * 100 : 0;
const overallUtilizationPct = totalABC > 0 ? Math.round((totalContractCost / totalABC) * 100) : 100;

const maxYearlyBudgetAmount = Math.max(
  ...Object.values(budgetVsCostByYear).flatMap(d => [d.abc, d.cost]),
  1000000
);

// Realistic Y-Axis Ticks for Budget vs Cost Chart
const budgetYAxisStep = 50_000_000;
const budgetYAxisMax = Math.ceil(maxYearlyBudgetAmount / budgetYAxisStep) * budgetYAxisStep || 250_000_000;
const budgetYAxisTicks = [
  budgetYAxisMax,
  budgetYAxisMax - budgetYAxisStep,
  budgetYAxisMax - budgetYAxisStep * 2,
  budgetYAxisMax - budgetYAxisStep * 3,
  budgetYAxisMax - budgetYAxisStep * 4,
  0
].filter(v => v >= 0);

// 1. Projects by Year (2018 to 2025)
const yearsList = [2018, 2019, 2020, 2021, 2022, 2023, 2024, 2025];
const yearData: Record<number, { count: number; cost: number }> = {
  2018: { count: 0, cost: 0 },
  2019: { count: 0, cost: 0 },
  2020: { count: 0, cost: 0 },
  2021: { count: 0, cost: 0 },
  2022: { count: 0, cost: 0 },
  2023: { count: 0, cost: 0 },
  2024: { count: 0, cost: 0 },
  2025: { count: 0, cost: 0 },
};

floodControlProjects.forEach(p => {
  const y = p.infraYear || 2023;
  if (yearData[y]) {
    yearData[y].count += 1;
    yearData[y].cost += p.contractCost;
  }
});
const maxYCount = Math.max(...Object.values(yearData).map(d => d.count), 15);

// Realistic Y-Axis Ticks for Projects Count Chart
const countYAxisStep = 5;
const countYAxisMax = Math.ceil(maxYCount / countYAxisStep) * countYAxisStep || 15;
const countYAxisTicks = [
  countYAxisMax,
  countYAxisMax - countYAxisStep,
  countYAxisMax - countYAxisStep * 2,
  0
].filter(v => v >= 0);

// 2. District Location Breakdown
let d1Count = 0, d1Cost = 0;
let d2Count = 0, d2Cost = 0;
floodControlProjects.forEach(p => {
  if (p.district === 'District 1') {
    d1Count++;
    d1Cost += p.contractCost;
  } else {
    d2Count++;
    d2Cost += p.contractCost;
  }
});
const totalProjectsCount = floodControlProjects.length;
const d1Pct = totalProjectsCount > 0 ? Math.round((d1Count / totalProjectsCount) * 100) : 82;
const d2Pct = 100 - d1Pct;

// 3. Types of Work Breakdown
const typeCounts: Record<string, { count: number; cost: number }> = {};
floodControlProjects.forEach(p => {
  let t = p.typeOfWork || 'Other Structure';
  if (t.includes('Drainage')) t = 'Construction of Drainage Structure';
  else if (t.includes('Slope')) t = 'Construction of Slope Protection Structure';
  else if (t.includes('Shore')) t = 'Construction of Shore Protection Structure';
  else if (t.includes('Mitigation')) t = 'Construction of Flood Mitigation Structure';
  
  if (!typeCounts[t]) typeCounts[t] = { count: 0, cost: 0 };
  typeCounts[t].count += 1;
  typeCounts[t].cost += p.contractCost;
});

const typeItems = [
  {
    name: 'Construction of Flood Mitigation Structure',
    label: 'Flood Mitigation Structure',
    count: typeCounts['Construction of Flood Mitigation Structure']?.count || 20,
    cost: typeCounts['Construction of Flood Mitigation Structure']?.cost || 0,
    barClass: 'bg-sky-500',
    dotClass: 'bg-sky-500'
  },
  {
    name: 'Construction of Drainage Structure',
    label: 'Drainage Structure',
    count: typeCounts['Construction of Drainage Structure']?.count || 7,
    cost: typeCounts['Construction of Drainage Structure']?.cost || 0,
    barClass: 'bg-emerald-500',
    dotClass: 'bg-emerald-500'
  },
  {
    name: 'Construction of Shore Protection Structure',
    label: 'Shore Protection Structure',
    count: typeCounts['Construction of Shore Protection Structure']?.count || 4,
    cost: typeCounts['Construction of Shore Protection Structure']?.cost || 0,
    barClass: 'bg-amber-500',
    dotClass: 'bg-amber-500'
  },
  {
    name: 'Construction of Slope Protection Structure',
    label: 'Slope Protection Structure',
    count: typeCounts['Construction of Slope Protection Structure']?.count || 3,
    cost: typeCounts['Construction of Slope Protection Structure']?.cost || 0,
    barClass: 'bg-rose-500',
    dotClass: 'bg-rose-500'
  },
];
const totalTypeCount = typeItems.reduce((acc, i) => acc + i.count, 0);

// 4. Top Contractors Breakdown
const contractorStats: Record<string, { count: number; cost: number }> = {};
floodControlProjects.forEach(p => {
  const name = (p.contractor || 'OTHER CONTRACTOR').trim();
  if (!contractorStats[name]) contractorStats[name] = { count: 0, cost: 0 };
  contractorStats[name].count += 1;
  contractorStats[name].cost += p.contractCost;
});

const contractorBarColors = ['bg-sky-500', 'bg-emerald-500', 'bg-indigo-500', 'bg-teal-500', 'bg-amber-500', 'bg-rose-500', 'bg-purple-500', 'bg-cyan-500'];

const sortedTopContractors = Object.entries(contractorStats)
  .map(([name, stat]) => ({ name, count: stat.count, cost: stat.cost }))
  .sort((a, b) => b.count - a.count || b.cost - a.cost)
  .slice(0, 8)
  .map((item, idx) => ({ ...item, barClass: contractorBarColors[idx % contractorBarColors.length] }));

const maxContractorCount = Math.max(...sortedTopContractors.map(c => c.count), 5);
---

<div class="space-y-6 mb-8 font-sans">
  
  <!-- Analytics Grid with 1x2 Featured Card + 2x2 Grid -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
    
    <!-- 1x2 Full-Width Card: Total Approved Budget vs Total Project Cost -->
    <div class="lg:col-span-2 bg-white p-6 rounded-none border border-slate-200 shadow-2xs flex flex-col justify-between">
      <div>
        <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-6 pb-3 border-b border-slate-200 gap-2">
          <div>
            <h3 class="text-lg font-semibold text-slate-900 tracking-tight">Total Approved Budget vs. Total Project Cost</h3>
            <p class="text-sm text-slate-500 mt-0.5">Financial comparison of Approved Budget for Contract (ABC) against Actual Contract Cost</p>
          </div>
        </div>

        <!-- Metric KPI Summary Cards -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
          <div class="p-4 rounded-none bg-indigo-50/60 border border-indigo-100">
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase font-semibold text-indigo-700 tracking-wider">Total Approved Budget (ABC)</span>
            </div>
