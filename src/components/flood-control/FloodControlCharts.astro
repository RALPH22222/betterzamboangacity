            {countYAxisTicks.map(tick => (
              <span class="leading-none">{tick}</span>
            ))}
          </div>

          <!-- Plot Area -->
          <div class="flex-1 relative h-52">
            <!-- Background Horizontal Grid Lines -->
            <div class="absolute inset-0 flex flex-col justify-between pointer-events-none">
              {countYAxisTicks.map((_, idx) => (
                <div class={`w-full border-b ${idx === countYAxisTicks.length - 1 ? 'border-slate-300 border-solid' : 'border-slate-100 border-dashed'}`}></div>
              ))}
