              {formatPHP(totalABC)}
            </div>
            <div class="text-xs text-slate-500 font-medium mt-1">
              Maximum allocated project funding
            </div>
          </div>

          <div class="p-4 rounded-none bg-sky-50/60 border border-sky-100">
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase font-semibold text-sky-700 tracking-wider">Total Project Cost</span> 
            </div>
            <div class="text-xl sm:text-2xl font-bold font-mono text-slate-900 mt-2">
              {formatPHP(totalContractCost)}
            </div>
            <div class="text-xs text-slate-500 font-medium mt-1">
              Actual contracted expenditure
            </div>
          </div>

          <div class="p-4 rounded-none bg-emerald-50/60 border border-emerald-100">
            <div class="flex items-center justify-between">
              <span class="text-xs uppercase font-semibold text-emerald-700 tracking-wider">Net Savings / Difference</span>
              <span class="px-1.5 py-0.5 text-xs font-mono font-semibold bg-emerald-100 text-emerald-800 rounded-none">
                -{totalSavingsPct.toFixed(1)}% Cost
              </span>
            </div>
            <div class="text-xl sm:text-2xl font-bold font-mono text-emerald-700 mt-2">
              {formatPHP(totalVariance)}
            </div>
            <div class="text-xs text-slate-500 font-medium mt-1">
              Awarded under approved budget ceiling
            </div>
          </div>
        </div>

        <!-- Realistic Chart Plotting Area with Left Y-Axis Ticks & Gridlines -->
        <div class="flex gap-3 pt-4 pb-2">
          <!-- Left Y-Axis Scale Ticks -->
          <div class="flex flex-col justify-between items-end text-xs font-mono text-slate-500 h-60 py-0.5 select-none pr-2 shrink-0 border-r border-slate-200">
            {budgetYAxisTicks.map(tick => (
              <span class="leading-none">{formatCompactPHP(tick)}</span>
            ))}
          </div>

          <!-- Plot Area -->
          <div class="flex-1 relative h-60">
            <!-- Background Horizontal Grid Lines -->
            <div class="absolute inset-0 flex flex-col justify-between pointer-events-none">
              {budgetYAxisTicks.map((_, idx) => (
                <div class={`w-full border-b ${idx === budgetYAxisTicks.length - 1 ? 'border-slate-300 border-solid' : 'border-slate-100 border-dashed'}`}></div>
              ))}
            </div>

            <!-- Realistic Flat-Top Column Bars -->
            <div class="relative z-10 flex items-end justify-between h-full px-2 gap-2 sm:gap-4">
              {yearsList.map(yr => {
                const data = budgetVsCostByYear[yr] || { abc: 0, cost: 0, count: 0 };
                const abcHeight = data.abc > 0 ? (data.abc / budgetYAxisMax) * 100 : 0;
                const costHeight = data.cost > 0 ? (data.cost / budgetYAxisMax) * 100 : 0;
                const hasData = data.abc > 0 || data.cost > 0;

                return (
                  <div class="flex-1 flex flex-col items-center group h-full justify-end">
                    {hasData && (
                      <div class="flex flex-col items-center mb-1 text-[10px] sm:text-xs font-semibold font-mono text-slate-700 opacity-90">
                        <span>{formatCompactPHP(data.cost)}</span>
                      </div>
                    )}

                    <div class="w-full flex items-end justify-center gap-1 h-full">
                      <!-- ABC Bar (Indigo - Flat rectangular, no rounded edges) -->
                      <div
                        class="w-1/2 max-w-[28px] bg-indigo-600 hover:bg-indigo-700 transition-colors cursor-pointer rounded-none"
                        style={`height: ${abcHeight}%;`}
                        title={`${yr} Approved Budget (ABC): ${formatPHP(data.abc)} (${data.count} projects)`}
                      ></div>
                      <!-- Contract Cost Bar (Sky - Flat rectangular, no rounded edges) -->
                      <div
                        class="w-1/2 max-w-[28px] bg-sky-500 hover:bg-sky-600 transition-colors cursor-pointer rounded-none"
                        style={`height: ${costHeight}%;`}
                        title={`${yr} Actual Contract Cost: ${formatPHP(data.cost)} (${data.count} projects)`}
                      ></div>
                    </div>

                    <span class="text-xs font-medium text-slate-600 mt-2 font-mono">
                      {yr}
                    </span>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
      </div>

      <!-- Footer & Legend -->
      <div class="flex flex-col sm:flex-row items-center justify-between mt-6 pt-4 border-t border-slate-100 gap-3 text-sm text-slate-500 font-medium">
