---
interface FooterLink {
  label: string;
  href: string;
  external?: boolean;
}

interface FooterColumn {
  title: string;
  links: FooterLink[];
}

const columns: FooterColumn[] = [
  {
    title: 'About',
    links: [
      { label: 'About Us', href: '/about' },
      { label: 'Open Data', href: '/open-data' },
      { label: 'Privacy Policy', href: '/privacy-policy' },
      { label: 'Terms of Service', href: '/terms-of-service' },
    ],
  },
  {
    title: 'Services',
    links: [
      { label: 'All Services', href: '/services' },
      { label: 'Disaster Preparedness', href: '/disaster' },
      { label: 'Business and Trade', href: '/services?category=Business%2C+Trade+and+Investment' },
      { label: 'Certificates and Vital Records', href: '/services?category=Certificates+and+Vital+Records' },
      { label: 'Health', href: '/services?category=Health+and+Wellness' },
    ],
  },
  {
    title: 'Government',
    links: [
      { label: 'City Officials', href: '/government' },
      { label: 'Departments', href: '/government/departments' },
      { label: 'Barangays', href: '/zamboanga/barangays' },
      { label: 'Transparency', href: '/transparency' },
    ],
  },
  {
    title: 'Official',
    links: [
      { label: 'zamboangacity.gov.ph', href: 'https://zamboangacity.gov.ph/', external: true },
    ],
  },
];
---

<footer class="bg-slate-900 text-white font-sans mt-auto border-t border-slate-800">
  <div class="container mx-auto px-4 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8 md:gap-10">
      
      <!-- Brand Overview Column (Spans 2 columns on desktop) -->
      <div class="lg:col-span-2">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-black text-lg shadow-sm">
            BZ
          </div>
          <span class="font-bold text-xl tracking-tight text-white">Better Zamboanga</span>
        </div>
        <p class="text-slate-400 text-xs sm:text-sm mb-6 leading-relaxed max-w-sm">
          Open-source civic tech initiative making government information and public services accessible for Zamboangueños.
        </p>
        
        <!-- Social Links -->
        <div class="flex items-center gap-3">
          <a
            href="https://www.facebook.com/BetterZamboangaCity"
            class="w-9 h-9 rounded-lg bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-blue-600 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit Better Zamboanga Facebook Page"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z" />
            </svg>
          </a>
          <a
            href="https://github.com/BetterZamboanga"
            class="w-9 h-9 rounded-lg bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white hover:bg-slate-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-500"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Visit Better Zamboanga GitHub Repository"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z" />
            </svg>
          </a>
        </div>
      </div>

      <!-- 4 Link Columns -->
      {columns.map((col) => (
        <div class="col-span-1">
          <h3 class="font-bold text-slate-100 mb-3 text-sm tracking-wide">{col.title}</h3>
          <ul class="space-y-2">
            {col.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="text-xs sm:text-sm text-slate-400 hover:text-white transition-colors focus:outline-none focus:underline inline-flex items-center gap-1"
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                  {link.external && (
                    <svg class="w-3 h-3 text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                  )}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Copyright Disclaimer Bar -->
    <div class="border-t border-slate-800 mt-12 pt-6 flex flex-col sm:flex-row justify-between items-center gap-4 text-xs text-slate-400">
      <p>
        &copy; {new Date().getFullYear()} Better Zamboanga · Not an official government website
      </p>
      <a
        href="/site-map"
        class="text-slate-400 hover:text-white transition-colors focus:outline-none focus:underline"
      >
        Sitemap
      </a>
    </div>
  </div>
</footer>
