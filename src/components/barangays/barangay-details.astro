---
import { fetchBarangayOfficials, type Barangay } from '../../lib/supabase';
import officialsData from '../../content/Barangay-officials/barangay-officials.json';
import popDataRaw from '../../content/Barangay-officials/population2024.json';

const popData: Record<string, { population: string, url: string, category: string }> = popDataRaw as any;

interface Props {
  barangay: Barangay;
}

const { barangay } = Astro.props;

// Fetch officials from Supabase database
const { data: dbOfficials } = await fetchBarangayOfficials(barangay.id);

let bgyOfficials = dbOfficials.map(o => ({
  POSITION: o.position,
  fullName: o.fullName
}));

if (bgyOfficials.length === 0) {
  const jsonOfficials = officialsData.filter(
    (o) => o.barangay_m.toLowerCase() === barangay.name.toLowerCase()
  );
  bgyOfficials = jsonOfficials.map(o => {
    const fn = o.FIRSTNAME || '';
    const mn = o.MIDDLENAME ? o.MIDDLENAME + ' ' : '';
    const ln = o.LASTNAME || '';
    const suf = o.SUFFIX ? ' ' + o.SUFFIX : '';
    return {
      POSITION: o.POSITION,
      fullName: `${fn} ${mn}${ln}${suf}`.replace(/\s+/g, ' ').trim()
    };
  });
}

const punongBarangayObj = bgyOfficials.find((o) => o.POSITION === 'Punong Barangay');
const kagawadsObj = bgyOfficials.filter((o) => o.POSITION === 'Sangguniang Barangay Member');
const skChairObj = bgyOfficials.find((o) => o.POSITION === 'SK Chairperson');

const pbName = punongBarangayObj ? punongBarangayObj.fullName : (barangay.barangayCaptain || 'Punong Barangay Roster Pending');
const skName = skChairObj ? skChairObj.fullName : 'SK Chairperson Roster Pending';

const popInfo = popData[barangay.name];
const displayPop = barangay.population || (popInfo ? popInfo.population : 'Data Pending');
const psgcUrl = barangay.psgcUrl || (popInfo ? popInfo.url : null);
---

<div class="space-y-6 font-sans max-w-[1200px] mx-auto">
  <!-- BARANGAY OVERVIEW HERO CARD -->
  <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs">
    <!-- Signature Vinta 4-Color Stripe -->
    <div class="h-2 w-full flex">
      <div class="flex-1 bg-[#0032A0]"></div>
      <div class="flex-1 bg-[#1A9714]"></div>
      <div class="flex-1 bg-[#F6CD18]"></div>
      <div class="flex-1 bg-[#B32435]"></div>
    </div>

    <div class="p-6 space-y-6">
      <!-- Title Header Block -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 pb-5">
        <div class="flex items-center gap-4">
          <img 
            src="/images/ZC.svg" 
            alt="Zamboanga City Seal" 
            class="w-14 h-14 shrink-0 object-contain" 
          />

          <div class="space-y-1">
            <h1 class="text-2xl sm:text-3xl font-bold text-slate-900">
              Barangay {barangay.name}
            </h1>
            
            <p class="text-xs sm:text-sm text-slate-600">
              Zamboanga City · District {barangay.district} ({barangay.coast}) · ZIP {barangay.zipCode}
            </p>
          </div>
        </div>

        <span class="text-xs font-semibold text-slate-700 bg-slate-100 border border-slate-200 px-3 py-1.5 rounded-md self-start md:self-auto">
          {barangay.category} Area
        </span>
      </div>

      <!-- 4 STATS -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        
        <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5">
          <span class="text-xs font-semibold text-slate-500 block">2024 Population</span>
          <div class="text-xl font-bold text-slate-900 mt-0.5">{displayPop}</div>
          {psgcUrl ? (
            <a 
              href={psgcUrl} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-[11px] text-[#0032A0] font-semibold hover:underline inline-flex items-center gap-1 mt-1"
            >
              <span>PSA Record</span>
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
              </svg>
            </a>
          ) : (
            <span class="text-[11px] text-slate-500 mt-1 block">PSA Census</span>
          )}
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5">
          <span class="text-xs font-semibold text-slate-500 block">District</span>
          <div class="text-xl font-bold text-slate-900 mt-0.5">District {barangay.district}</div>
          <span class="text-[11px] text-slate-600 block mt-1">{barangay.coast}</span>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5">
          <span class="text-xs font-semibold text-slate-500 block">ZIP Code</span>
          <div class="text-xl font-bold text-slate-900 font-mono mt-0.5">{barangay.zipCode}</div>
          <span class="text-[11px] text-slate-600 block mt-1">Zamboanga City</span>
        </div>

        <div class="bg-slate-50 border border-slate-200 rounded-lg p-3.5">
          <span class="text-xs font-semibold text-slate-500 block">Classification</span>
          <div class="text-xl font-bold text-slate-900 mt-0.5">{barangay.category}</div>
          <span class="text-[11px] text-slate-600 block mt-1">Barangay Type</span>
        </div>

      </div>
    </div>
  </div>

  <!-- BARANGAY OFFICIALS DIRECTORY -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 space-y-6 shadow-xs">
    
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
      <div>
        <h2 class="text-xl font-bold text-slate-900">Barangay Officials</h2>
        <p class="text-xs text-slate-500">Elected officials for Term 2023–2026</p>
      </div>
      <span class="text-xs font-semibold text-slate-700 bg-slate-100 border border-slate-200 px-3 py-1 rounded-md self-start sm:self-auto">
        Term 2023–2026
      </span>
    </div>

    <!-- EXECUTIVE LEADERSHIP: CAPTAIN & SK CHAIRPERSON -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      
      <!-- Barangay Captain -->
      <div class="bg-slate-50 border border-slate-200 border-l-4 border-l-[#0032A0] rounded-xl p-4.5">
        <span class="text-xs font-bold text-[#0032A0] uppercase tracking-wider block">
          Punong Barangay (Captain)
        </span>
        <div class="text-lg font-bold text-slate-900 mt-1">{pbName}</div>
      </div>

      <!-- SK Chairperson -->
      <div class="bg-slate-50 border border-slate-200 border-l-4 border-l-emerald-600 rounded-xl p-4.5">
        <span class="text-xs font-bold text-emerald-800 uppercase tracking-wider block">
          SK Chairperson
        </span>
        <div class="text-lg font-bold text-slate-900 mt-1">{skName}</div>
      </div>

    </div>

    <!-- BARANGAY KAGAWADS (COUNCILORS) -->
    <div class="space-y-3 pt-2">
      <div class="flex items-center justify-between border-b border-slate-100 pb-2">
        <h3 class="text-xs font-bold uppercase text-slate-600 tracking-wider">
          Barangay Kagawads (Councilors)
        </h3>
        <span class="text-xs text-slate-500 font-medium">
          {kagawadsObj.length} Members
        </span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {kagawadsObj.length > 0 ? (
          kagawadsObj.map((k, index) => (
            <div class="bg-white border border-slate-200 rounded-lg p-3 flex items-center justify-between gap-3 shadow-2xs">
              <div class="flex items-center gap-2.5 min-w-0">
                <span class="text-slate-400 font-mono text-xs font-bold w-5 shrink-0 text-right">
                  {index + 1}.
                </span>
                <span class="text-slate-900 font-semibold text-sm truncate">
                  {k.fullName}
                </span>
              </div>
              <span class="text-[11px] text-slate-500 font-medium shrink-0">
                Kagawad
              </span>
            </div>
          ))
        ) : (
          <div class="col-span-full p-6 bg-slate-50 border border-slate-200 rounded-xl text-slate-500 text-xs text-center font-medium">
            Barangay Kagawad roster pending synchronization with DILG.
          </div>
        )}
      </div>
    </div>

    <!-- Data Credit Footer -->
    <div class="pt-3 border-t border-slate-100 text-xs text-slate-500">
      Data sourced from DILG official records and PSA Census 2024.
    </div>

  </div>
</div>
