---
---

<div class="space-y-10 font-sans">
  <!-- Page Header (Light Theme with Ordinance Style) -->
  <div class="text-center max-w-3xl mx-auto space-y-4">
    <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-blue-50 text-[#0032A0] text-xs font-black uppercase tracking-wider border border-blue-200 shadow-xs">
      Official Barangay Repository
    </span>
    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
      98 Barangays of Zamboanga City
    </h1>
    <p class="text-base sm:text-lg text-slate-600 font-medium leading-relaxed">
      Explore all 98 Barangays across Congressional District 1 (West Coast) and District 2 (East Coast). Sourced directly from official LGU &amp; PSA census records.
    </p>
  </div>

  <!-- Educational & Geographic Overview Card (Decorated with ZC.svg Seal & Vinta Ribbon) -->
  <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs space-y-6">
    <!-- Vinta Flag 4-Color Top Ribbon -->
    <div class="h-2.5 w-full flex">
      <div class="flex-1 bg-[#0032A0]"></div>
      <div class="flex-1 bg-[#1A9714]"></div>
      <div class="flex-1 bg-[#F6CD18]"></div>
      <div class="flex-1 bg-[#B32435]"></div>
    </div>

    <div class="p-6 sm:p-8 space-y-6 pt-2">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 border-b border-slate-100 pb-5">
        <div class="flex items-center gap-4">
          <!-- Official Zamboanga City Seal -->
          <img 
            src="/images/ZC.svg" 
            alt="Zamboanga City Seal & Vinta" 
            class="w-14 h-14 sm:w-16 sm:h-16 shrink-0 object-contain drop-shadow-xs" 
          />

          <div class="space-y-1">
            <div class="inline-flex items-center gap-2 text-xs font-bold text-[#0032A0] uppercase tracking-wider">
              <svg class="w-4 h-4 text-[#0032A0]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              </svg>
              Political Subdivisions &amp; Governance
            </div>
            <h2 class="text-xl sm:text-2xl font-black text-slate-900 tracking-tight">
              Congressional Districts Overview
            </h2>
          </div>
        </div>

        <span class="text-xs font-bold px-3.5 py-2 bg-amber-50 text-amber-800 rounded-xl border border-amber-200 shadow-2xs self-start md:self-auto shrink-0 flex items-center gap-2">
          98 Total Barangays · 2 Districts
        </span>
      </div>

      <p class="text-slate-700 text-sm leading-relaxed font-medium">
        Zamboanga City is politically divided into <strong class="text-slate-900 font-bold">98 Barangays</strong> across two Legislative Congressional Districts. District 1 encompasses 38 barangays in the West Coast and Poblacion, while District 2 covers 60 barangays along the East Coast and offshore islands.
      </p>
      <!-- SIDE-BY-SIDE DISTRICT CARDS -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-2">
        
        <!-- District 1 Side Card (West Coast & Poblacion) -->
        <div class="group bg-gradient-to-br from-amber-50/60 via-white to-slate-50/50 border border-amber-200/90 rounded-2xl overflow-hidden shadow-xs hover:shadow-md hover:border-amber-300 transition-all duration-300 flex flex-col justify-between">
          <!-- Top Colored Ribbon -->
          <div class="h-1.5 w-full bg-gradient-to-r from-amber-500 to-yellow-400"></div>

          <div class="p-6 space-y-4">
            <!-- Header Row -->
            <div class="flex items-center justify-between gap-3">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100/90 text-amber-900 text-xs font-black uppercase tracking-wider border border-amber-300/80 shadow-2xs">
                <svg class="w-3.5 h-3.5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                </svg>
                1st Legislative District
              </span>

              <span class="text-xs font-extrabold text-amber-900 bg-amber-200/60 px-3 py-1 rounded-lg border border-amber-300/60">
                38 Barangays
              </span>
            </div>

            <!-- Title & Overview -->
            <div class="space-y-1.5">
              <h3 class="text-xl font-black text-slate-900 tracking-tight group-hover:text-amber-900 transition-colors">
                West Coast &amp; Poblacion
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed font-medium">
                Encompasses central commercial Poblacion zones (Zones I–IV) alongside western coastal and agricultural communities extending from Ayala to Labuan and Limpapa.
              </p>
            </div>

            <!-- Key Barangays & Zones Chips -->
            <div class="pt-1 space-y-2">
              <span class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Key Subdivisions &amp; Hubs</span>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2.5 py-1 bg-white border border-amber-200 rounded-lg text-[11px] font-bold text-slate-700 shadow-2xs">
                  Poblacion (Zones I–IV)
                </span>
                <span class="px-2.5 py-1 bg-white border border-amber-200 rounded-lg text-[11px] font-bold text-slate-700 shadow-2xs">
                  Ayala &amp; San Rocco
                </span>
                <span class="px-2.5 py-1 bg-white border border-amber-200 rounded-lg text-[11px] font-bold text-slate-700 shadow-2xs">
                  Labuan &amp; Limpapa
                </span>
              </div>
            </div>
          </div>

          <!-- Card Bottom Stats Bar -->
          <div class="px-6 py-3 bg-amber-50/80 border-t border-amber-100 flex items-center justify-between text-xs font-bold text-amber-900">
            <span class="text-slate-500 font-semibold">Jurisdiction Share</span>
            <span class="text-amber-800 font-black">38.8% (38 of 98 Barangays)</span>
          </div>
        </div>

        <!-- District 2 Side Card (East Coast & Islands) -->
        <div class="group bg-gradient-to-br from-blue-50/60 via-white to-slate-50/50 border border-blue-200/90 rounded-2xl overflow-hidden shadow-xs hover:shadow-md hover:border-blue-300 transition-all duration-300 flex flex-col justify-between">
          <!-- Top Colored Ribbon -->
          <div class="h-1.5 w-full bg-gradient-to-r from-[#0032A0] to-blue-500"></div>

          <div class="p-6 space-y-4">
            <!-- Header Row -->
            <div class="flex items-center justify-between gap-3">
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-100/90 text-[#0032A0] text-xs font-black uppercase tracking-wider border border-blue-300/80 shadow-2xs">
                <svg class="w-3.5 h-3.5 text-[#0032A0]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 002 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 002 2h1.5a2.5 2.5 0 002.5-2.5V11.4" />
                </svg>
                2nd Legislative District
              </span>

              <span class="text-xs font-extrabold text-[#0032A0] bg-blue-200/60 px-3 py-1 rounded-lg border border-blue-300/60">
                60 Barangays
              </span>
            </div>

            <!-- Title & Overview -->
            <div class="space-y-1.5">
              <h3 class="text-xl font-black text-slate-900 tracking-tight group-hover:text-[#0032A0] transition-colors">
                East Coast &amp; Islands
              </h3>
              <p class="text-xs text-slate-600 leading-relaxed font-medium">
                Covers eastern commercial hubs, rural highway corridors stretching to Curuan and Vitali, plus offshore island barangays including Sacol, Sta. Cruz, and Manalipa.
              </p>
            </div>

            <!-- Key Barangays & Zones Chips -->
            <div class="pt-1 space-y-2">
              <span class="block text-[10px] font-black uppercase tracking-widest text-slate-400">Key Subdivisions &amp; Hubs</span>
              <div class="flex flex-wrap gap-1.5">
                <span class="px-2.5 py-1 bg-white border border-blue-200 rounded-lg text-[11px] font-bold text-slate-700 shadow-2xs">
                  Tetuan &amp; Talon-Talon
                </span>
                <span class="px-2.5 py-1 bg-white border border-blue-200 rounded-lg text-[11px] font-bold text-slate-700 shadow-2xs">
                  Curuan &amp; Vitali Highway
                </span>
                <span class="px-2.5 py-1 bg-white border border-blue-200 rounded-lg text-[11px] font-bold text-slate-700 shadow-2xs">
                  Sacol &amp; Manalipa Islands
                </span>
              </div>
            </div>
          </div>

          <!-- Card Bottom Stats Bar -->
          <div class="px-6 py-3 bg-blue-50/80 border-t border-blue-100 flex items-center justify-between text-xs font-bold text-[#0032A0]">
            <span class="text-slate-500 font-semibold">Jurisdiction Share</span>
            <span class="text-[#0032A0] font-black">61.2% (60 of 98 Barangays)</span>
          </div>
        </div>

      </div>iv>
    </div>
  </div>
</div>
