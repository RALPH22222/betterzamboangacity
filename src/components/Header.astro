---
interface SubItem {
  name: string;
  href: string;
  upcoming?: boolean;
}

interface NavItem {
  name: string;
  href: string;
  dropdown?: SubItem[];
}

const navigation: NavItem[] = [
  {
    name: 'Zamboanga City',
    href: '#',
    dropdown: [
      { name: 'City Overview', href: '#', upcoming: true },
      { name: 'Flood Control Projects', href: '/zamboanga-city/flood-control' },
      { name: 'History & Culture', href: '/zamboanga-city/history' },
      { name: 'City Map & Geography', href: '#', upcoming: true },
    ],
  },
  {
    name: 'Services',
    href: '/disaster',
    dropdown: [
      { name: 'Disaster Preparedness', href: '/disaster' },
      { name: 'All Services', href: '#', upcoming: true },
      { name: 'Business & Trade', href: '#', upcoming: true },
      { name: 'Certificates & Vital Records', href: '#', upcoming: true },
      { name: 'Health & Wellness', href: '#', upcoming: true },
    ],
  },
  {
    name: 'Ordinances',
    href: '/ordinances/regulatory-ordinances',
    dropdown: [
      { name: 'Regulatory Ordinances', href: '/ordinances/regulatory-ordinances' },
      { name: 'Appropriation Ordinances', href: '#', upcoming: true },
      { name: 'Revenue Ordinances', href: '#', upcoming: true },
    ],
  },
  {
    name: 'Government',
    href: '#',
    dropdown: [
      { name: 'City Officials', href: '#', upcoming: true },
      { name: 'City Departments', href: '#', upcoming: true },
      { name: 'Barangay Directory', href: '/government/barangays' },
    ],
  },
  {
    name: 'About',
    href: '#',
    dropdown: [
      { name: 'About Better Zamboanga', href: '#', upcoming: true },
      { name: 'Open Data Initiative', href: '#', upcoming: true },
      { name: 'Volunteer & Contribute', href: '#', upcoming: true },
    ],
  },
];
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 font-sans shadow-xs transition-all">
  <!-- Ultra-Thin Vinta Pastel Theme Accent Top Stripe (Shown on scroll) -->
  <div id="header-color-bar" class="absolute top-0 left-0 h-[3px] w-full flex opacity-0 transition-opacity duration-300">
    <div class="w-[16.66%] h-full bg-[#c084fc]"></div>
    <div class="w-[16.66%] h-full bg-[#38bdf8]"></div>
    <div class="w-[16.66%] h-full bg-[#4ade80]"></div>
    <div class="w-[16.66%] h-full bg-[#475569]"></div>
    <div class="w-[16.66%] h-full bg-[#fca5a5]"></div>
    <div class="w-[16.66%] h-full bg-[#fde047]"></div>
  </div>
  <div class="container mx-auto px-4 sm:px-6 max-w-[1600px] w-full">
    <div class="flex items-center justify-between h-16 sm:h-20 gap-4">
      
      <!-- Brand Logo & Emblem -->
      <div class="shrink-0 flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 focus:outline-none focus:ring-2 focus:ring-blue-600 rounded-xl p-1 group" aria-label="Better Zamboanga City Homepage">
          <!-- Official Zamboanga City Emblem -->
          <img src="/images/ZC.svg" alt="Zamboanga City Seal" class="w-11 h-11 sm:w-13 sm:h-13 object-contain" />
          
          <div class="block leading-tight">
            <div class="flex items-center gap-1">
              <span class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
                Better<span class="text-blue-600">Zamboanga</span><span class="text-amber-500 font-extrabold">City</span>
              </span>
            </div>
            <span class="text-[11px] text-slate-500 hidden sm:block font-medium">A community-run portal for Zamboangueños</span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation Menu -->
      <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-1 h-full">
        {navigation.map((item) => (
          <div class="relative group h-full flex items-center">
            <a
              href={item.href}
              class="flex items-center gap-1 text-sm font-semibold text-slate-700 hover:text-blue-600 hover:bg-blue-50/80 px-3.5 py-2 rounded-xl transition-all focus:outline-none focus:ring-2 focus:ring-blue-600"
              aria-haspopup={item.dropdown ? "true" : "false"}
            >
              <span>{item.name}</span>
              {item.dropdown && (
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-blue-600 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {item.dropdown && (
              <div class="absolute top-full left-0 w-80 bg-white border border-slate-200/90 shadow-2xl shadow-blue-900/10 rounded-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 transform origin-top -translate-y-2 group-hover:translate-y-0 z-50 p-2">
                <ul class="space-y-0.5" role="menu" aria-label={`${item.name} Submenu`}>
                  {item.dropdown.map((subItem) => (
                    <li role="none">
                      {subItem.upcoming ? (
                        <div class="px-3 py-2 text-xs sm:text-sm font-medium text-slate-400 flex items-center justify-between cursor-not-allowed select-none rounded-xl transition-colors hover:bg-amber-50/30">
                          <span class="text-slate-500 font-medium">{subItem.name}</span>
                          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-md bg-amber-50 text-amber-900 border border-amber-200/80 text-[10px] font-bold tracking-tight shadow-2xs shrink-0">
                            <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                            <span>Under Development</span>
                          </span>
                        </div>
                      ) : (
                        <a
                          href={subItem.href}
                          role="menuitem"
                          class="block px-3 py-2 text-xs sm:text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 rounded-xl focus:bg-blue-50 focus:text-blue-700 focus:outline-none transition-all flex items-center justify-between group/sub"
                        >
                          <span>{subItem.name}</span>
                          <svg class="w-3.5 h-3.5 opacity-0 group-hover/sub:opacity-100 text-blue-600 -translate-x-1 group-hover/sub:translate-x-0 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                          </svg>
                        </a>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- Right Action Button -->
      <div class="flex items-center gap-3">
        <a
          href="https://discord.gg/HC43M83js"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-4 sm:px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-[#5865F2] hover:bg-[#4752C4] active:bg-[#3c45a5] rounded-xl shadow-sm hover:shadow-md transition-all focus:outline-none focus:ring-2 focus:ring-[#5865F2] focus:ring-offset-2 group"
        >
          <svg class="w-4 h-4 sm:w-4.5 sm:h-4.5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
          </svg>
          <span>Join Now</span>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="hdr-mobile-menu-btn"
          type="button"
          class="lg:hidden p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-600 transition-colors"
          aria-expanded="false"
          aria-controls="hdr-mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg id="hdr-menu-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="hdr-close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="hdr-mobile-menu"
    class="hidden absolute top-full left-0 w-full bg-white border-b border-slate-200 shadow-2xl flex-col lg:hidden max-h-[85vh] overflow-y-auto divide-y divide-slate-100 animate-fade-in"
  >
    <div class="p-4 space-y-2">
      {navigation.map((item) => (
        <div class="py-1">
          {item.dropdown ? (
            <details class="group">
              <summary class="flex items-center justify-between py-2.5 px-2 text-sm font-bold text-slate-800 cursor-pointer rounded-lg hover:bg-slate-50 list-none">
                <span>{item.name}</span>
                <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <ul class="pl-3 py-1 space-y-1 border-l-2 border-blue-400 bg-slate-50/80 rounded-r-xl my-1">
                {item.dropdown.map((subItem) => (
                  <li>
                    {subItem.upcoming ? (
                      <div class="py-2 px-3 text-xs font-medium text-slate-400 flex items-center justify-between cursor-not-allowed select-none">
                        <span class="text-slate-500 font-medium">{subItem.name}</span>
                        <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-md bg-amber-50 text-amber-800 border border-amber-200 text-[10px] font-bold tracking-tight shrink-0">
                          <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
                          <span>Under Development</span>
                        </span>
                      </div>
                    ) : (
                      <a href={subItem.href} class="block py-2 px-3 text-xs font-semibold text-slate-700 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                        {subItem.name}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} class="block py-2.5 px-2 text-sm font-bold text-slate-800 hover:text-blue-600">
              {item.name}
            </a>
          )}
        </div>
      ))}
    </div>

    <div class="p-4 bg-slate-50 border-t border-slate-200">
      <a
        href="https://discord.gg/HC43M83js"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-center gap-2 w-full px-5 py-3 text-sm font-bold text-white bg-[#5865F2] hover:bg-[#4752C4] rounded-xl shadow-xs transition-colors"
      >
        <svg class="w-5 h-5 fill-current shrink-0" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.061 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.028zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
        </svg>
        <span>Join Now</span>
      </a>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const colorBar = document.getElementById('header-color-bar');
    if (colorBar) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 20) {
          colorBar.classList.remove('opacity-0');
          colorBar.classList.add('opacity-100');
        } else {
          colorBar.classList.remove('opacity-100');
          colorBar.classList.add('opacity-0');
        }
      });
    }

    const btn = document.getElementById('hdr-mobile-menu-btn');
    const menu = document.getElementById('hdr-mobile-menu');
    const menuIcon = document.getElementById('hdr-menu-icon');
    const closeIcon = document.getElementById('hdr-close-icon');

    if (btn && menu && menuIcon && closeIcon) {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';
        btn.setAttribute('aria-expanded', (!isExpanded).toString());
        menu.classList.toggle('hidden');
        menu.classList.toggle('flex');
        menuIcon.classList.toggle('hidden');
        closeIcon.classList.toggle('hidden');
      });
    }
  });
</script>
