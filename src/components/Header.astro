---
interface SubItem {
  name: string;
  href: string;
  upcoming?: boolean;
}

interface NavItem {
  name: string;
  href: string;
  dropdown?: SubItem[];
}

const navigation: NavItem[] = [
  {
    name: 'Zamboanga City',
    href: '/about',
    dropdown: [
      { name: 'City Overview', href: '/about' },
      { name: 'History & Culture', href: '/about/history' },
      { name: '98 Barangays', href: '/zamboanga/barangays' },
      { name: 'City Map & Geography', href: '/about/map' },
    ],
  },
  {
    name: 'Services',
    href: '/services',
    dropdown: [
      { name: 'All Services', href: '/services' },
      { name: 'Disaster Preparedness', href: '/disaster' },
      { name: 'Business & Trade', href: '/services?category=Business%2C+Trade+and+Investment' },
      { name: 'Certificates & Vital Records', href: '/services?category=Certificates+and+Vital+Records' },
      { name: 'Health & Wellness', href: '/services?category=Health+and+Wellness' },
    ],
  },
  {
    name: 'Ordinances',
    href: '/ordinances',
  },
  {
    name: 'Government',
    href: '/government',
    dropdown: [
      { name: 'City Officials', href: '/government' },
      { name: 'City Departments', href: '/government/departments' },
      { name: 'Barangay Directory', href: '/government/barangays' },
    ],
  },
  {
    name: 'About',
    href: '/about',
    dropdown: [
      { name: 'About Better Zamboanga', href: '/about' },
      { name: 'Open Data Initiative', href: '/open-data' },
      { name: 'Volunteer & Contribute', href: '/volunteer' },
    ],
  },
];
---

<header class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 font-sans shadow-xs transition-all">
  <!-- Ultra-Thin Vinta Pastel Theme Accent Top Stripe (Shown on scroll) -->
  <div id="header-color-bar" class="absolute top-0 left-0 h-[3px] w-full flex opacity-0 transition-opacity duration-300">
    <div class="w-[20.66%] h-full bg-[#c084fc]"></div>
    <div class="w-[20.66%] h-full bg-[#38bdf8]"></div>
    <div class="w-[20.66%] h-full bg-[#4ade80]"></div>
    <div class="w-[20.66%] h-full bg-[#475569]"></div>
    <div class="w-[20.66%] h-full bg-[#fca5a5]"></div>
    <div class="w-[20.66%] h-full bg-[#fde047]"></div>
  </div>
  <div class="container mx-auto px-4">
    <div class="flex items-center justify-between h-16 sm:h-20">
      
      <!-- Brand Logo Area -->
      <div class="shrink-0 flex items-center gap-3">
        <a href="/" class="flex items-center gap-2.5 focus:outline-none focus:ring-2 focus:ring-blue-600 rounded-xl p-1 group" aria-label="Better Zamboanga City Homepage">
          <!-- Official Zamboanga City Emblem -->
          <img src="/images/ZC.svg" alt="Zamboanga City Seal" class="w-11 h-11 sm:w-13 sm:h-13 object-contain" />
          
          <div class="block leading-tight">
            <div class="flex items-center gap-1">
              <span class="text-lg sm:text-xl font-black text-slate-900 tracking-tight">
                Better<span class="text-blue-600">Zamboanga</span><span class="text-amber-500 font-extrabold">City</span>
              </span>
            </div>
            <span class="text-[11px] text-slate-500 hidden sm:block font-medium">A community-run portal for Zamboangueños</span>
          </div>
        </a>
      </div>

      <!-- Desktop Navigation Menu -->
      <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-1 h-full">
        {navigation.map((item) => (
          <div class="relative group h-full flex items-center">
            <a
              href={item.href}
              class="flex items-center gap-1 text-sm font-semibold text-slate-700 hover:text-blue-600 hover:bg-blue-50/80 px-3.5 py-2 rounded-xl transition-all focus:outline-none focus:ring-2 focus:ring-blue-600"
              aria-haspopup={item.dropdown ? "true" : "false"}
            >
              <span>{item.name}</span>
              {item.dropdown && (
                <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-blue-600 group-hover:rotate-180 transition-transform duration-200" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              )}
            </a>

            {item.dropdown && (
              <div class="absolute top-full left-0 w-64 bg-white border border-slate-200/90 shadow-2xl shadow-blue-900/10 rounded-2xl opacity-0 invisible group-hover:opacity-100 group-hover:visible group-focus-within:opacity-100 group-focus-within:visible transition-all duration-200 transform origin-top -translate-y-2 group-hover:translate-y-0 z-50 p-2">
                <ul class="space-y-0.5" role="menu" aria-label={`${item.name} Submenu`}>
                  {item.dropdown.map((subItem) => (
                    <li role="none">
                      <a
                        href={subItem.href}
                        role="menuitem"
                        class="block px-3.5 py-2.5 text-xs sm:text-sm font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700 rounded-xl focus:bg-blue-50 focus:text-blue-700 focus:outline-none transition-all flex items-center justify-between group/sub"
                      >
                        <span>{subItem.name}</span>
                        <svg class="w-3.5 h-3.5 opacity-0 group-hover/sub:opacity-100 text-blue-600 -translate-x-1 group-hover/sub:translate-x-0 transition-all" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                        </svg>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ))}
      </nav>

      <!-- Right Action Button -->
      <div class="flex items-center gap-3">
        <a
          href="/volunteer"
          class="inline-flex items-center justify-center gap-2 px-5 py-2.5 text-xs sm:text-sm font-bold text-white bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 active:bg-blue-900 rounded-xl shadow-sm hover:shadow-md transition-all focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2 group"
        >
          <span>Join Us!</span>
          <svg class="w-4 h-4 text-blue-100 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="hdr-mobile-menu-btn"
          type="button"
          class="lg:hidden p-2.5 rounded-xl bg-slate-50 border border-slate-200 text-slate-700 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-blue-600 transition-colors"
          aria-expanded="false"
          aria-controls="hdr-mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg id="hdr-menu-icon" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="hdr-close-icon" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div
    id="hdr-mobile-menu"
    class="hidden absolute top-full left-0 w-full bg-white border-b border-slate-200 shadow-2xl flex-col lg:hidden max-h-[85vh] overflow-y-auto divide-y divide-slate-100 animate-fade-in"
  >
    <div class="p-4 space-y-2">
      {navigation.map((item) => (
        <div class="py-1">
          {item.dropdown ? (
            <details class="group">
              <summary class="flex items-center justify-between py-2.5 px-2 text-sm font-bold text-slate-800 cursor-pointer rounded-lg hover:bg-slate-50 list-none">
                <span>{item.name}</span>
                <svg class="w-4 h-4 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
                </svg>
              </summary>
              <ul class="pl-3 py-1 space-y-1 border-l-2 border-blue-400 bg-slate-50/80 rounded-r-xl my-1">
                {item.dropdown.map((subItem) => (
                  <li>
                    <a href={subItem.href} class="block py-2 px-3 text-xs font-semibold text-slate-700 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-colors">
                      {subItem.name}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ) : (
            <a href={item.href} class="block py-2.5 px-2 text-sm font-bold text-slate-800 hover:text-blue-600">
              {item.name}
            </a>
          )}
        </div>
      ))}
      
      <div class="pt-3 pb-2">
        <a href="/volunteer" class="w-full flex items-center justify-center gap-2 py-3 px-4 text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 rounded-xl shadow-md">
          <span>Join Us!</span>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('hdr-mobile-menu-btn');
  const menu = document.getElementById('hdr-mobile-menu');
  const openIcon = document.getElementById('hdr-menu-icon');
  const closeIcon = document.getElementById('hdr-close-icon');
  const colorBar = document.getElementById('header-color-bar');

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', (!isExpanded).toString());
      menu.classList.toggle('hidden');
      menu.classList.toggle('flex');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }

  // Show color bar when TopBar disappears (scroll > 40px)
  window.addEventListener('scroll', () => {
    const cb = document.getElementById('header-color-bar');
    if (window.scrollY > 40) {
      cb?.classList.remove('opacity-0');
      cb?.classList.add('opacity-100');
    } else {
      cb?.classList.remove('opacity-100');
      cb?.classList.add('opacity-0');
    }
  });
</script>
