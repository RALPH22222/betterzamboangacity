---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// 1. Server Date & Time (PHT - Asia/Manila)
const now = new Date();
const serverDateStr = new Intl.DateTimeFormat('en-PH', {
  timeZone: 'Asia/Manila',
  weekday: 'short',
  month: 'short',
  day: 'numeric',
}).format(now);

const serverTimeStr = new Intl.DateTimeFormat('en-PH', {
  timeZone: 'Asia/Manila',
  hour: '2-digit',
  minute: '2-digit',
  hour12: true,
}).format(now);

// 2. Live Weather Fetch on Server (Zamboanga City: Lat 6.9214, Lon 122.0790)
let initialTemp = "--°C";
let initialDesc = "Loading...";
let initialDetails = "--% Hum";

try {
  const weatherRes = await fetch('https://api.open-meteo.com/v1/forecast?latitude=6.9214&longitude=122.0790&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m');
  if (weatherRes.ok) {
    const data = await weatherRes.json();
    if (data && data.current) {
      initialTemp = `${Math.round(data.current.temperature_2m)}°C`;
      const code = data.current.weather_code ?? 0;
      if (code === 0 || code === 1) initialDesc = 'Clear';
      else if (code === 2 || code === 3) initialDesc = 'Partly Cloudy';
      else if (code === 45 || code === 48) initialDesc = 'Foggy';
      else if (code >= 51 && code <= 82) initialDesc = 'Rain Showers';
      else if (code >= 95) initialDesc = 'Thunderstorm';
      else initialDesc = 'Fair';
      
      initialDetails = `${data.current.relative_humidity_2m}% Hum • ${Math.round(data.current.wind_speed_10m)} km/h`;
    }
  }
} catch (err) {
  initialTemp = "28°C";
  initialDesc = "Clear";
  initialDetails = "77% Hum";
}

// 3. Live Forex USD/PHP Fetch on Server
let initialForex = "₱62.44";
try {
  const forexRes = await fetch('https://open.er-api.com/v6/latest/USD');
  if (forexRes.ok) {
    const data = await forexRes.json();
    if (data && data.rates && data.rates.PHP) {
      initialForex = `₱${data.rates.PHP.toFixed(2)}`;
    }
  }
} catch (err) {}
