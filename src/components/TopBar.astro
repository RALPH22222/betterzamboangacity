---
interface Props {
  className?: string;
}

const { className = "" } = Astro.props;

// 1. Server Date & Time (PHT - Asia/Manila)
const now = new Date();
const serverDateStr = new Intl.DateTimeFormat('en-PH', {
  timeZone: 'Asia/Manila',
  weekday: 'short',
  month: 'short',
  day: 'numeric',
}).format(now);

const serverTimeStr = new Intl.DateTimeFormat('en-PH', {
  timeZone: 'Asia/Manila',
  hour: '2-digit',
  minute: '2-digit',
  hour12: true,
}).format(now);

// 2. Live Weather Fetch on Server (Zamboanga City: Lat 6.9214, Lon 122.0790)
let initialTemp = "--°C";
let initialDesc = "Loading...";
let initialDetails = "--% Hum";

try {
  const weatherRes = await fetch('https://api.open-meteo.com/v1/forecast?latitude=6.9214&longitude=122.0790&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m');
  if (weatherRes.ok) {
    const data = await weatherRes.json();
    if (data && data.current) {
      initialTemp = `${Math.round(data.current.temperature_2m)}°C`;
      const code = data.current.weather_code ?? 0;
      if (code === 0 || code === 1) initialDesc = 'Clear';
      else if (code === 2 || code === 3) initialDesc = 'Partly Cloudy';
      else if (code === 45 || code === 48) initialDesc = 'Foggy';
      else if (code >= 51 && code <= 82) initialDesc = 'Rain Showers';
      else if (code >= 95) initialDesc = 'Thunderstorm';
      else initialDesc = 'Fair';
      
      initialDetails = `${data.current.relative_humidity_2m}% Hum • ${Math.round(data.current.wind_speed_10m)} km/h`;
    }
  }
} catch (err) {
  initialTemp = "28°C";
  initialDesc = "Clear";
  initialDetails = "77% Hum";
}

// 3. Live Forex PHP Base Rates Fetch on Server (https://open.er-api.com/v6/latest/PHP)
let initialRates: Record<string, string> = {};
let initialLastUpdated = "Daily Feed Active";

try {
  const forexRes = await fetch('https://open.er-api.com/v6/latest/PHP', { cache: 'no-store' });
  if (forexRes.ok) {
    const data = await forexRes.json();
    if (data && data.rates) {
      Object.keys(data.rates).forEach(k => {
        if (data.rates[k] && data.rates[k] > 0) {
          const phpVal = 1 / data.rates[k];
          initialRates[k] = phpVal < 0.1 ? phpVal.toFixed(4) : phpVal.toFixed(2);
        }
      });
      if (data.time_last_update_utc) {
        initialLastUpdated = `Updated: ${data.time_last_update_utc.slice(0, 16)}`;
      }
    }
  }
} catch (err) {}
---

<aside 
  aria-label="Emergency Hotlines and City Live Information" 
  class={`relative bg-slate-50 border-b border-slate-200/80 text-slate-700 text-xs sm:text-[13px] font-sans shadow-xs z-50 ${className}`}
>
  <!-- Ultra-Thin Vinta Pastel Theme Accent Top Stripe -->
  <div class="h-[3px] w-full flex">
    <div class="w-[16.66%] h-full bg-[#c084fc]"></div>
    <div class="w-[16.66%] h-full bg-[#38bdf8]"></div>
    <div class="w-[16.66%] h-full bg-[#4ade80]"></div>
    <div class="w-[16.66%] h-full bg-[#475569]"></div>
    <div class="w-[16.66%] h-full bg-[#fca5a5]"></div>
    <div class="w-[16.66%] h-full bg-[#fde047]"></div>
  </div>

  <div class="container mx-auto px-4 py-2 sm:py-2.5 flex flex-wrap items-center justify-between gap-y-2 gap-x-5 max-w-[1600px]">
    
    <!-- Left Section: Clean City Branding & Live Time (PHT) -->
    <div class="flex items-center gap-3 shrink-0">
      <div class="flex items-center gap-1.5">
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#c084fc]"></span>
          <span class="w-2 h-2 rounded-full bg-[#38bdf8]"></span>
          <span class="w-2 h-2 rounded-full bg-[#4ade80]"></span>
          <span class="w-2 h-2 rounded-full bg-[#fca5a5]"></span>
          <span class="w-2 h-2 rounded-full bg-[#fde047]"></span>
        </span>
        <span class="text-xs uppercase tracking-wider text-slate-900 font-extrabold">Zamboanga City</span>
      </div>

      <span class="h-4 w-px bg-slate-300"></span>

      <!-- Live PHT Date & Time Clock -->
      <div class="flex items-center gap-2 text-slate-700 font-medium text-xs sm:text-[13px]">
        <svg class="w-4 h-4 text-blue-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span id="topbar-date" class="font-semibold text-slate-800">{serverDateStr}</span>
        <span class="text-slate-300">•</span>
        <span id="topbar-clock" class="font-mono font-bold text-slate-950">{serverTimeStr}</span>
        <span class="text-[11px] text-slate-500 font-mono font-semibold">PHT</span>
      </div>
    </div>

    <!-- Center Section: Real-time Weather & Single Rotating PHP Exchange Rate (Changes every 5s) -->
    <div class="hidden md:flex items-center gap-4 text-xs sm:text-[13px]">
      
      <!-- Live Zamboanga Weather (Clean Typography) -->
      <div 
        id="topbar-weather-container" 
        class="flex items-center gap-1.5 text-slate-800 hover:text-slate-950 transition-colors cursor-default"
        title="Live Weather for Zamboanga City (Lat 6.92°, Lon 122.08°)"
      >
        <span id="topbar-weather-icon" class="inline-flex items-center text-amber-500">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
        </span>
        <span id="topbar-weather-temp" class="font-bold text-slate-900">{initialTemp}</span>
        <span id="topbar-weather-desc" class="text-slate-600 text-xs">{initialDesc}</span>
        <span id="topbar-weather-details" class="hidden lg:inline-block text-[11px] text-slate-500 pl-1.5 border-l border-slate-300 ml-0.5">
          {initialDetails}
        </span>
      </div>

      <span class="h-4 w-px bg-slate-300"></span>

      <!-- Live Rotating Exchange Rate (Displays 1 rate at a time, rotates every 5s) -->
      <div class="relative">
        <button
          id="topbar-forex-btn"
          type="button"
          class="flex items-center gap-2 text-slate-800 hover:text-emerald-700 transition-colors cursor-pointer group"
          aria-expanded="false"
          aria-controls="topbar-forex-menu"
        >
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
          
          <div id="topbar-forex-rotator" class="flex items-center gap-1.5 font-mono text-xs sm:text-[13px] transition-opacity duration-300">
            <span id="rate-display" class="font-bold text-slate-900">{initialRates.USD ? `1 USD = ₱ ${initialRates.USD}` : '1 USD = ₱ --'}</span>
          </div>
        </button>

        <!-- Dropdown Forex Rates Popover -->
        <div
          id="topbar-forex-menu"
          class="hidden absolute left-0 top-full mt-2 w-80 sm:w-96 bg-white border border-slate-200 rounded-2xl shadow-xl z-50 p-4 text-slate-700 animate-fade-in"
          role="dialog"
          aria-label="Philippine Peso Exchange Rates Directory"
        >
          <div class="flex items-center justify-between border-b border-slate-100 pb-2.5 mb-2.5">
            <div class="flex items-center gap-2">
              <span class="p-1.5 rounded-xl bg-emerald-50 text-emerald-600 border border-emerald-100">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <div>
                <h4 class="text-xs font-bold text-slate-900 uppercase tracking-wider">Philippine Peso (PHP) Directory</h4>
                <p id="forex-last-updated" class="text-[10px] text-slate-500">{initialLastUpdated}</p>
              </div>
            </div>
            <button id="topbar-forex-close" class="text-slate-400 hover:text-slate-700 p-1 rounded-lg hover:bg-slate-100 cursor-pointer">
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
              </svg>
            </button>
          </div>

          <!-- Currency Search Input -->
          <div class="mb-2.5">
            <input 
              id="forex-search-input" 
              type="text" 
              placeholder="Search 160+ currencies (e.g. USD, EUR, SAR, MYR)..." 
              class="w-full px-3 py-1.5 text-xs border border-slate-200 rounded-xl bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-all placeholder:text-slate-400"
            />
          </div>

          <!-- Scrollable Grid of All Exchange Rates -->
          <div id="forex-rates-grid" class="grid grid-cols-2 gap-2 text-xs font-mono max-h-72 overflow-y-auto pr-1 mb-2.5">
            {Object.entries(initialRates).map(([code, val]) => (
              <div class="p-2 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between">
                <span class="text-slate-600 font-sans font-semibold">{code}</span>
                <span class="font-bold text-slate-900">1 {code} = ₱ {val}</span>
              </div>
            ))}
          </div>

          <div class="pt-2 border-t border-slate-100 text-[10px] text-slate-400 flex justify-between items-center">
            <span>Rotates every 5s • Daily Live Feed</span>
            <span class="text-emerald-600 font-semibold">Base: 1 PHP</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</aside>

<script>
  let forexRotatorInterval: number | undefined;

  function initTopBarLogic() {
    // Clear any previous interval on re-init
    if (forexRotatorInterval) {
      clearInterval(forexRotatorInterval);
      forexRotatorInterval = undefined;
    }

    // 1. Live Philippine Standard Time (PHT) Clock
    const dateEl = document.getElementById('topbar-date');
    const clockEl = document.getElementById('topbar-clock');

    function updateClock() {
      const now = new Date();
      if (dateEl) {
        dateEl.textContent = new Intl.DateTimeFormat('en-PH', {
          timeZone: 'Asia/Manila',
          weekday: 'short',
          month: 'short',
          day: 'numeric',
        }).format(now);
      }
      if (clockEl) {
        clockEl.textContent = new Intl.DateTimeFormat('en-PH', {
          timeZone: 'Asia/Manila',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: true,
        }).format(now);
      }
    }

    updateClock();
    setInterval(updateClock, 1000);

    // 2. Real-time Weather Fetch for Zamboanga City (Lat: 6.9214, Lon: 122.0790)
    const tempEl = document.getElementById('topbar-weather-temp');
    const descEl = document.getElementById('topbar-weather-desc');
    const iconEl = document.getElementById('topbar-weather-icon');
    const detailsEl = document.getElementById('topbar-weather-details');

    const svgSun = `<svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`;
    const svgCloud = `<svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" /></svg>`;
    const svgRain = `<svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 16.2A4.5 4.5 0 0017.5 8h-1.8A7 7 0 104 14.9M16 14v6m-4-4v6m-4-4v6" /></svg>`;
    const svgThunder = `<svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`;

    const weatherCodeMap: Record<number, { desc: string; iconSvg: string }> = {
      0: { desc: 'Clear', iconSvg: svgSun },
      1: { desc: 'Mainly Clear', iconSvg: svgSun },
      2: { desc: 'Partly Cloudy', iconSvg: svgCloud },
      3: { desc: 'Overcast', iconSvg: svgCloud },
      45: { desc: 'Foggy', iconSvg: svgCloud },
      48: { desc: 'Depositing Rime Fog', iconSvg: svgCloud },
      51: { desc: 'Light Drizzle', iconSvg: svgRain },
      53: { desc: 'Moderate Drizzle', iconSvg: svgRain },
      55: { desc: 'Dense Drizzle', iconSvg: svgRain },
      61: { desc: 'Slight Rain', iconSvg: svgRain },
      63: { desc: 'Moderate Rain', iconSvg: svgRain },
      65: { desc: 'Heavy Rain', iconSvg: svgRain },
      80: { desc: 'Rain Showers', iconSvg: svgRain },
      81: { desc: 'Moderate Showers', iconSvg: svgRain },
      82: { desc: 'Violent Showers', iconSvg: svgRain },
      95: { desc: 'Thunderstorm', iconSvg: svgThunder },
      96: { desc: 'Thunderstorm & Hail', iconSvg: svgThunder },
      99: { desc: 'Heavy Thunderstorm', iconSvg: svgThunder },
    };

    async function fetchWeather() {
      try {
        const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=6.9214&longitude=122.0790&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m');
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.current) {
          const temp = Math.round(data.current.temperature_2m);
          const code = data.current.weather_code ?? 0;
          const humidity = data.current.relative_humidity_2m;
          const wind = Math.round(data.current.wind_speed_10m);

          const weatherInfo = weatherCodeMap[code] || { desc: 'Fair', iconSvg: svgSun };

          if (tempEl) tempEl.textContent = `${temp}°C`;
          if (descEl) descEl.textContent = weatherInfo.desc;
          if (iconEl) iconEl.innerHTML = weatherInfo.iconSvg;
          if (detailsEl) detailsEl.textContent = `${humidity}% Hum • ${wind} km/h`;
        }
      } catch (err) {
        console.warn('TopBar: Live weather fetch notice', err);
      }
    }

    fetchWeather();

    let allCalculatedRates: Record<string, string> = {};
    let rotateCurrencies: string[] = [];
    let rotateIdx = 0;

    const gridEl = document.getElementById('forex-rates-grid');
    const searchInput = document.getElementById('forex-search-input') as HTMLInputElement | null;
    const lastUpdatedEl = document.getElementById('forex-last-updated');

    function renderForexGrid(filterText = '') {
      if (!gridEl) return;
      const term = filterText.trim().toUpperCase();
      const keys = Object.keys(allCalculatedRates).filter(k => k.includes(term));

      if (keys.length === 0) {
        gridEl.innerHTML = `<div class="col-span-2 p-3 text-center text-slate-400 text-xs">No matching currency found</div>`;
        return;
      }

      gridEl.innerHTML = keys.map(code => {
        const val = allCalculatedRates[code];
        return `
          <div class="p-2 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-between hover:bg-emerald-50/50 transition-colors">
            <span class="text-slate-700 font-sans font-semibold">${code}</span>
            <span class="font-bold text-slate-900">1 ${code} = ₱ ${val}</span>
          </div>
        `;
      }).join('');
    }

    function startRotator() {
      const displayEl = document.getElementById('rate-display');
      const rotatorContainer = document.getElementById('topbar-forex-rotator');

      if (!displayEl || !rotatorContainer) return;

      forexRotatorInterval = window.setInterval(() => {
        if (rotateCurrencies.length === 0) return;
        rotateIdx = (rotateIdx + 1) % rotateCurrencies.length;
        const code = rotateCurrencies[rotateIdx];
        const val = allCalculatedRates[code] || '--';

        rotatorContainer.classList.add('opacity-0');
        setTimeout(() => {
          displayEl.textContent = `1 ${code} = ₱ ${val}`;
          rotatorContainer.classList.remove('opacity-0');
        }, 200);
      }, 5000);
    }

    async function fetchForex() {
      try {
        const res = await fetch('https://open.er-api.com/v6/latest/PHP');
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.rates) {
          const rates = data.rates;
          const newCalculated: Record<string, string> = {};

          Object.keys(rates).forEach(code => {
            if (rates[code] && rates[code] > 0) {
              const phpVal = 1 / rates[code];
              newCalculated[code] = phpVal < 0.1 ? phpVal.toFixed(4) : phpVal.toFixed(2);
            }
          });

          allCalculatedRates = newCalculated;
          rotateCurrencies = Object.keys(newCalculated); // Dynamically includes ALL 160+ currencies!

          if (data.time_last_update_utc && lastUpdatedEl) {
            lastUpdatedEl.textContent = `Updated: ${data.time_last_update_utc.slice(0, 16)} (Daily API Feed)`;
          }

          renderForexGrid(searchInput ? searchInput.value : '');

          const displayEl = document.getElementById('rate-display');
          if (displayEl && rotateIdx === 0 && allCalculatedRates.USD) {
            displayEl.textContent = `1 USD = ₱ ${allCalculatedRates.USD}`;
          }
        }
      } catch (err) {
        console.warn('TopBar: Live forex fetch notice', err);
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const val = (e.target as HTMLInputElement).value;
        renderForexGrid(val);
      });
    }

    fetchForex();
    startRotator();

    // 4. Safe Dropdown Toggle Logic
    const forexBtn = document.getElementById('topbar-forex-btn');
    const forexMenu = document.getElementById('topbar-forex-menu');
    const forexClose = document.getElementById('topbar-forex-close');

    function closeForex() {
      if (forexMenu) forexMenu.classList.add('hidden');
      if (forexBtn) forexBtn.setAttribute('aria-expanded', 'false');
    }

    if (forexBtn && forexMenu) {
      forexBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isHidden = forexMenu.classList.contains('hidden');
        if (isHidden) {
          forexMenu.classList.remove('hidden');
          forexBtn.setAttribute('aria-expanded', 'true');
        } else {
          closeForex();
        }
      });

      if (forexClose) {
        forexClose.addEventListener('click', () => closeForex());
      }
    }

    document.addEventListener('click', (e) => {
      const target = e.target as Node;
      if (forexMenu && forexBtn && !forexMenu.contains(target) && !forexBtn.contains(target)) {
        closeForex();
      }
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeForex();
      }
    });
  }

  document.addEventListener('astro:page-load', initTopBarLogic);
  if (document.readyState !== 'loading') {
    initTopBarLogic();
  }
</script>
