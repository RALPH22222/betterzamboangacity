<script>
  function initTopBarLogic() {
    // 1. Live Philippine Standard Time (PHT) Clock
    const dateEl = document.getElementById('topbar-date');
    const clockEl = document.getElementById('topbar-clock');

    function updateClock() {
      const now = new Date();
      if (dateEl) {
        dateEl.textContent = new Intl.DateTimeFormat('en-PH', {
          timeZone: 'Asia/Manila',
          weekday: 'short',
          month: 'short',
          day: 'numeric',
        }).format(now);
      }
      if (clockEl) {
        clockEl.textContent = new Intl.DateTimeFormat('en-PH', {
          timeZone: 'Asia/Manila',
          hour: '2-digit',
          minute: '2-digit',
          second: '2-digit',
          hour12: true,
        }).format(now);
      }
    }

    updateClock();
    setInterval(updateClock, 1000);

    // 2. Real-time Weather Fetch for Zamboanga City (Lat: 6.9214, Lon: 122.0790)
    const tempEl = document.getElementById('topbar-weather-temp');
    const descEl = document.getElementById('topbar-weather-desc');
    const iconEl = document.getElementById('topbar-weather-icon');
    const detailsEl = document.getElementById('topbar-weather-details');

    const svgSun = `<svg class="w-4 h-4 text-amber-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>`;
    const svgCloud = `<svg class="w-4 h-4 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 00-9.78 2.096A4.001 4.001 0 003 15z" /></svg>`;
    const svgRain = `<svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 16.2A4.5 4.5 0 0017.5 8h-1.8A7 7 0 104 14.9M16 14v6m-4-4v6m-4-4v6" /></svg>`;
    const svgThunder = `<svg class="w-4 h-4 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" /></svg>`;

    const weatherCodeMap: Record<number, { desc: string; iconSvg: string }> = {
      0: { desc: 'Clear', iconSvg: svgSun },
      1: { desc: 'Mainly Clear', iconSvg: svgSun },
      2: { desc: 'Partly Cloudy', iconSvg: svgCloud },
      3: { desc: 'Overcast', iconSvg: svgCloud },
      45: { desc: 'Foggy', iconSvg: svgCloud },
      48: { desc: 'Depositing Rime Fog', iconSvg: svgCloud },
      51: { desc: 'Light Drizzle', iconSvg: svgRain },
      53: { desc: 'Moderate Drizzle', iconSvg: svgRain },
      55: { desc: 'Dense Drizzle', iconSvg: svgRain },
      61: { desc: 'Slight Rain', iconSvg: svgRain },
      63: { desc: 'Moderate Rain', iconSvg: svgRain },
      65: { desc: 'Heavy Rain', iconSvg: svgRain },
      80: { desc: 'Rain Showers', iconSvg: svgRain },
      81: { desc: 'Moderate Showers', iconSvg: svgRain },
      82: { desc: 'Violent Showers', iconSvg: svgRain },
      95: { desc: 'Thunderstorm', iconSvg: svgThunder },
      96: { desc: 'Thunderstorm & Hail', iconSvg: svgThunder },
      99: { desc: 'Heavy Thunderstorm', iconSvg: svgThunder },
    };

    async function fetchWeather() {
      try {
        const res = await fetch('https://api.open-meteo.com/v1/forecast?latitude=6.9214&longitude=122.0790&current=temperature_2m,relative_humidity_2m,weather_code,wind_speed_10m');
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.current) {
          const temp = Math.round(data.current.temperature_2m);
          const code = data.current.weather_code ?? 0;
          const humidity = data.current.relative_humidity_2m;
          const wind = Math.round(data.current.wind_speed_10m);

          const weatherInfo = weatherCodeMap[code] || { desc: 'Fair', iconSvg: svgSun };

          if (tempEl) tempEl.textContent = `${temp}°C`;
          if (descEl) descEl.textContent = weatherInfo.desc;
          if (iconEl) iconEl.innerHTML = weatherInfo.iconSvg;
          if (detailsEl) detailsEl.textContent = `${humidity}% Hum • ${wind} km/h`;
        }
      } catch (err) {
        console.warn('TopBar: Live weather fetch notice', err);
      }
    }

    fetchWeather();

    // 3. Real-time USD/PHP Exchange Rate Fetch
    const forexEl = document.getElementById('topbar-forex-rate');
    async function fetchForex() {
      try {
        const res = await fetch('https://open.er-api.com/v6/latest/USD');
        if (!res.ok) return;
        const data = await res.json();
        if (data && data.rates && data.rates.PHP) {
          const rate = data.rates.PHP.toFixed(2);
          if (forexEl) forexEl.textContent = `₱${rate}`;
        }
      } catch (err) {
        console.warn('TopBar: Live forex fetch notice', err);
      }
    }

    fetchForex();

    // 4. Hotlines Dropdown Toggle & Backdrop Handling
    const hotlinesBtn = document.getElementById('topbar-hotlines-btn');
    const hotlinesMenu = document.getElementById('topbar-hotlines-menu');
    const hotlinesArrow = document.getElementById('topbar-hotlines-arrow');
    const hotlinesClose = document.getElementById('topbar-hotlines-close');

    if (hotlinesBtn && hotlinesMenu) {
      const btn = hotlinesBtn;
      const menu = hotlinesMenu;

      function toggleMenu(show?: boolean) {
        const isCurrentlyHidden = menu.classList.contains('hidden');
        const shouldShow = show !== undefined ? show : isCurrentlyHidden;

        if (shouldShow) {
          menu.classList.remove('hidden');
          btn.setAttribute('aria-expanded', 'true');
          if (hotlinesArrow) hotlinesArrow.classList.add('rotate-180');
        } else {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          if (hotlinesArrow) hotlinesArrow.classList.remove('rotate-180');
        }
      }

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        toggleMenu();
      });

      if (hotlinesClose) {
        hotlinesClose.addEventListener('click', () => toggleMenu(false));
      }

      // Close on outside click
      document.addEventListener('click', (e) => {
        if (!menu.contains(e.target as Node) && !btn.contains(e.target as Node)) {
          toggleMenu(false);
        }
      });

      // Close on Escape key
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') toggleMenu(false);
      });
    }
  }

  document.addEventListener('astro:page-load', initTopBarLogic);
  if (document.readyState !== 'loading') {
    initTopBarLogic();
  }
</script>
