<section class="space-y-4 pt-4">
  <div>
    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
      Emergency Hotlines
    </h2>
    <p class="text-xs sm:text-sm text-slate-600">
      Tap any hotline number to dial instantly or copy to clipboard. Landlines dial 062 within Zamboanga City.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 items-start">
    
    <!-- CARD 1: EMERGENCY & GOVERNMENT -->
    <div class="bg-white border border-slate-200 rounded-xl p-6 flex flex-col justify-start gap-4 transition-colors hover:border-slate-400 h-full">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3">
        <h3 class="text-xs font-bold text-red-600 uppercase tracking-widest flex items-center gap-1.5">
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
          <span>Emergency & Government</span>
        </h3>
      </div>

      <div class="space-y-3">
        <div>
          <div class="text-xs font-medium text-slate-500 mb-1">National Emergency Hotline</div>
          <div class="inline-flex items-center gap-2 bg-slate-50 border border-slate-200 rounded-lg px-3 py-1.5">
            <a href="tel:911" class="text-xl font-normal font-mono text-slate-900 hover:text-blue-600 transition-colors flex items-center gap-1.5">
              <svg class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
              <span>911</span>
            </a>
            <button type="button" data-copy-phone="911" class="text-slate-400 hover:text-blue-600 transition-colors p-0.5 ml-1 cursor-pointer" title="Copy">
              <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
              <svg class="w-4 h-4 check-icon hidden text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- CARD 2: RESCUE & DISASTER RESPONSE -->
    <div class="bg-white border border-slate-200 rounded-xl p-6 flex flex-col justify-start gap-4 transition-colors hover:border-slate-400 h-full">
