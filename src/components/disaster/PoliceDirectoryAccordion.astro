---
import type { PoliceStation } from '../../data/disaster-data';

interface Props {
  policeStations: PoliceStation[];
}

const { policeStations } = Astro.props;
---

<div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 transition-colors hover:border-slate-300">
  <details class="group" open>
    <summary class="flex items-center justify-between cursor-pointer list-none select-none">
      <div class="flex items-center gap-3.5">
        <img src="/images/zcpo-seal.png" alt="ZCPO Seal" class="w-10 h-10 object-contain shrink-0" />
        <div>
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>See the full 12 police precinct directory</span>
          </h3>
          <p class="text-xs text-slate-500 font-medium mt-0.5">ZCPO Precinct Stations covering East Coast, Central, and West Coast Sectors</p>
        </div>
      </div>
      <div class="flex items-center gap-2 text-xs font-semibold text-blue-600">
        <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <div class="mt-6 pt-6 border-t border-slate-200 space-y-4">
      <!-- Search & Filter Bar for Police -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-slate-50 p-3 border border-slate-200 rounded-xl">
        <div class="relative flex-1">
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="police-search"
            placeholder="Search precinct or location (e.g., Vitali, Tetuan, Ayala)..."
            class="w-full pl-9 pr-3 py-2 bg-white border border-slate-200 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-blue-600"
          />
        </div>
        <div class="flex items-center gap-1.5 overflow-x-auto text-[11px]" id="police-sector-filters">
          <button type="button" data-filter="all" class="police-filter-btn px-3 py-1.5 bg-blue-600 text-white border border-blue-600 rounded-lg font-medium whitespace-nowrap cursor-pointer">All (12)</button>
          <button type="button" data-filter="Central" class="police-filter-btn px-3 py-1.5 bg-white text-slate-600 border border-slate-200 rounded-lg font-medium hover:bg-slate-100 whitespace-nowrap cursor-pointer">Central Sector</button>
          <button type="button" data-filter="East Coast" class="police-filter-btn px-3 py-1.5 bg-white text-slate-600 border border-slate-200 rounded-lg font-medium hover:bg-slate-100 whitespace-nowrap cursor-pointer">East Coast</button>
          <button type="button" data-filter="West Coast" class="police-filter-btn px-3 py-1.5 bg-white text-slate-600 border border-slate-200 rounded-lg font-medium hover:bg-slate-100 whitespace-nowrap cursor-pointer">West Coast</button>
        </div>
      </div>

      <!-- List / Grid of Precinct Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 items-start" id="police-list">
        {policeStations.map((st) => (
          <div
            class="police-card bg-white border border-slate-200 rounded-xl p-4 flex flex-col justify-start gap-2.5 hover:border-slate-400 transition-colors shadow-2xs h-full"
            data-sector={st.sector}
          >
            <div class="flex items-start justify-between gap-2 border-b border-slate-100 pb-2">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 bg-blue-50 text-blue-700 border border-blue-200 text-xs font-mono font-semibold rounded-md">
                  {st.station}
                </span>
                <span class="text-sm font-bold text-slate-900">
                  {st.location}
                </span>
              </div>
              <span class="text-[10px] uppercase font-mono tracking-wider px-2 py-0.5 bg-slate-100 text-slate-600 border border-slate-200 rounded-md shrink-0">
                {st.sector}
              </span>
            </div>

            <div class="flex items-center justify-between gap-3 pt-1">
              <div class="text-lg sm:text-xl font-normal font-mono text-slate-800 tracking-wide select-all">
                {st.number}
              </div>

              <div class="flex items-center gap-1.5 shrink-0">
                <a
                  href={`tel:${st.number.replace(/[^0-9]/g, '')}`}
                  class="px-2.5 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg text-xs font-medium transition-colors flex items-center gap-1 shadow-2xs"
                  title={`Call ${st.station} (${st.location})`}
                  aria-label={`Call ${st.station} at ${st.number}`}
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>Call</span>
                </a>
                <button
                  type="button"
                  data-copy-phone={st.number}
                  class="px-2.5 py-1.5 bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 rounded-lg text-xs font-medium transition-colors flex items-center gap-1 shadow-2xs cursor-pointer"
                  title="Copy number"
                  aria-label={`Copy ${st.number}`}
                >
                  <svg class="w-3.5 h-3.5 copy-icon text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <svg class="w-3.5 h-3.5 check-icon hidden text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                  <span>Copy</span>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </details>
</div>
