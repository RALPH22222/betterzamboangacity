---
---

<section class="space-y-4 pt-2">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
    <div>
      <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
        Emergency Facilities Directory Map
      </h2>
      <p class="text-xs sm:text-sm text-slate-600 max-w-2xl mt-0.5">
        Locate hospitals, police precincts, fire substations, and disaster rescue centers across Zamboanga City with live directions.
      </p>
    </div>
    
    <button
      type="button"
      id="geo-locate-btn"
      class="inline-flex items-center justify-center gap-2 px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-semibold transition-colors shadow-2xs shrink-0 cursor-pointer"
    >
      <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
      </svg>
      <span>Find Nearest Facility</span>
    </button>
  </div>

  <!-- Clean Card Container -->
  <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs flex flex-col">
    
    <!-- Filter & Search Controls Bar -->
    <div class="bg-slate-50 p-3.5 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3">
      
      <!-- Category Filter Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto text-xs" id="map-category-filters">
        
        <button type="button" data-map-filter="all" class="map-filter-btn px-3 py-1.5 rounded-lg bg-slate-900 text-white font-medium border border-slate-900 transition-colors whitespace-nowrap cursor-pointer flex items-center gap-1.5">
          <span>All Facilities</span>
        </button>

        <button type="button" data-map-filter="hospital" class="map-filter-btn px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 text-slate-700 font-medium border border-slate-200 transition-colors whitespace-nowrap cursor-pointer flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-rose-600" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19 10.5h-5.5V5h-3v5.5H5v3h5.5V19h3v-5.5H19v-3z"/>
          </svg>
          <span>Hospitals</span>
        </button>

        <button type="button" data-map-filter="police" class="map-filter-btn px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 text-slate-700 font-medium border border-slate-200 transition-colors whitespace-nowrap cursor-pointer flex items-center gap-1.5">
          <svg class="w-3.5 h-3.5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
          <span>Police Precincts</span>
        </button>

      </div>

      <!-- Quick Search -->
      <div class="relative w-full md:w-64">
        <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
        <input
          type="text"
          id="map-search-input"
          placeholder="Filter map by name or location..."
          class="w-full pl-9 pr-3 py-1.5 bg-white border border-slate-200 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-slate-400"
        />
      </div>
    </div>

    <!-- Main Map & Sidebar -->
    <div class="grid grid-cols-1 lg:grid-cols-12 min-h-[460px]">
      
      <!-- Leaflet Map Container -->
      <div class="lg:col-span-8 relative min-h-[380px] lg:min-h-[460px]">
        <div id="leaflet-emergency-map" class="w-full h-full min-h-[380px] lg:min-h-[460px] z-0 bg-slate-100"></div>
        
        <!-- Status Overlay -->
        <div class="absolute bottom-3 left-3 z-[400] bg-white/95 backdrop-blur-md border border-slate-200 px-3 py-1.5 rounded-lg text-[11px] font-medium text-slate-700 shadow-xs flex items-center gap-2 pointer-events-none">
          <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
          <span id="map-counter-text">Showing all emergency facilities</span>
        </div>
      </div>

      <!-- Facilities List Sidebar Drawer -->
      <div class="lg:col-span-4 bg-slate-50 border-t lg:border-t-0 lg:border-l border-slate-200 p-3.5 flex flex-col justify-between max-h-[460px] overflow-hidden">
        <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-2 flex items-center justify-between">
          <span>Facility Directory</span>
          <span id="user-geo-status" class="text-[10px] text-emerald-700 font-mono font-semibold"></span>
        </div>

        <div id="facility-sidebar-list" class="space-y-2 overflow-y-auto pr-1 grow max-h-[360px]">
          <!-- Dynamically populated via script -->
        </div>

        <div class="pt-2.5 border-t border-slate-200 text-[11px] text-slate-500 text-center font-medium">
          Select any facility for details and navigation
        </div>
      </div>

    </div>

  </div>
</section>
