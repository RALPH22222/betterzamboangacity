---
import type { FireStation } from '../../data/disaster-data';

interface Props {
  fireStations: FireStation[];
}

const { fireStations } = Astro.props;
---

<div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 transition-colors hover:border-slate-300 mt-6">
  <details class="group" open>
    <summary class="flex items-center justify-between cursor-pointer list-none select-none">
      <div class="flex items-center gap-3.5">
        <img src="/images/bfp-seal.png" alt="BFP Region IX Seal" class="w-10 h-10 object-contain shrink-0" />
        <div>
          <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
            <span>See the full 30 fire substation directory</span>
          </h3>
          <p class="text-xs text-slate-500 font-medium mt-0.5">Zamboanga City Fire District sub-stations across all barangays</p>
        </div>
      </div>
      <div class="flex items-center gap-2 text-xs font-semibold text-red-600">
        <svg class="w-5 h-5 text-slate-400 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </div>
    </summary>

    <div class="mt-6 pt-6 border-t border-slate-200 space-y-4">
      <!-- Search & Filter Bar for Fire -->
      <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 bg-slate-50 p-3 border border-slate-200 rounded-xl">
        <div class="relative flex-1">
          <svg class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="fire-search"
            placeholder="Search fire substation or barangay (e.g., Central, Pasonanca, Sangali)..."
            class="w-full pl-9 pr-3 py-2 bg-white border border-slate-200 rounded-lg text-xs text-slate-800 placeholder-slate-400 focus:outline-none focus:border-red-600"
          />
        </div>
        <div class="flex items-center gap-1.5 overflow-x-auto text-[11px]" id="fire-sector-filters">
          <button type="button" data-filter="all" class="fire-filter-btn px-3 py-1.5 bg-red-600 text-white border border-red-600 rounded-lg font-medium whitespace-nowrap cursor-pointer">All (30)</button>
          <button type="button" data-filter="Central" class="fire-filter-btn px-3 py-1.5 bg-white text-slate-600 border border-slate-200 rounded-lg font-medium hover:bg-slate-100 whitespace-nowrap cursor-pointer">Central District</button>
          <button type="button" data-filter="East Coast" class="fire-filter-btn px-3 py-1.5 bg-white text-slate-600 border border-slate-200 rounded-lg font-medium hover:bg-slate-100 whitespace-nowrap cursor-pointer">East Coast</button>
          <button type="button" data-filter="West Coast" class="fire-filter-btn px-3 py-1.5 bg-white text-slate-600 border border-slate-200 rounded-lg font-medium hover:bg-slate-100 whitespace-nowrap cursor-pointer">West Coast</button>
        </div>
      </div>

      <!-- Grid of Fire Substation Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-3 items-start" id="fire-list">
        {fireStations.map((st) => (
          <div
            class="fire-card bg-white border border-slate-200 rounded-xl p-4 flex flex-col justify-start gap-2.5 hover:border-slate-400 transition-colors shadow-2xs h-full"
            data-sector={st.sector}
          >
            <div class="flex items-start justify-between gap-2 border-b border-slate-100 pb-2">
              <div>
                <span class="text-sm font-bold text-slate-900 block">
                  {st.station}
                </span>
                <span class="text-xs text-slate-500 font-medium">
                  {st.location}
                </span>
              </div>
              <span class="text-[10px] uppercase font-mono tracking-wider px-2 py-0.5 bg-red-50 text-red-700 border border-red-200 rounded-md shrink-0">
                {st.sector}
              </span>
            </div>

            <div class="space-y-2 pt-1">
              {st.numbers.map((num) => (
                <div class="flex items-center justify-between gap-3 bg-slate-50/80 border border-slate-200/60 p-2 rounded-lg">
                  <div class="text-base sm:text-lg font-normal font-mono text-slate-800 tracking-wide select-all">
                    {num}
                  </div>

                  <div class="flex items-center gap-1.5 shrink-0">
                    <a
                      href={`tel:${num.replace(/[^0-9]/g, '')}`}
                      class="px-2.5 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-xs font-medium transition-colors flex items-center gap-1 shadow-2xs"
                      title={`Call ${num}`}
                      aria-label={`Call ${num}`}
                    >
                      <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                      </svg>
                      <span>Call</span>
                    </a>
                    <button
                      type="button"
                      data-copy-phone={num}
                      class="px-2.5 py-1.5 bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 rounded-lg text-xs font-medium transition-colors flex items-center gap-1 shadow-2xs cursor-pointer"
                      title="Copy number"
                      aria-label={`Copy ${num}`}
                    >
                      <svg class="w-3.5 h-3.5 copy-icon text-slate-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                      </svg>
                      <svg class="w-3.5 h-3.5 check-icon hidden text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>Copy</span>
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </details>
</div>
