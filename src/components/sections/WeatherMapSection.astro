---
import WeatherWidget from '../WeatherWidget.astro';
import MapWidget from '../MapWidget.astro';

// Zamboanga City Districts / Zones for dynamic location switching
const locations = [
  { id: 'city-center', name: 'Zamboanga City Center', lat: 6.9214, lon: 122.0790, address: 'Zamboanga City Hall, N.S. Valderrosa St, Zamboanga City 7000' },
  { id: 'pasonanca', name: 'Pasonanca District', lat: 6.9458, lon: 122.0645, address: 'Pasonanca Park & Water District, Zamboanga City 7000' },
  { id: 'santa-maria', name: 'Santa Maria', lat: 6.9320, lon: 122.0710, address: 'Santa Maria Central, Zamboanga City 7000' },
  { id: 'tetuan', name: 'Tetuan', lat: 6.9180, lon: 122.0910, address: 'Tetuan Commercial Zone, Zamboanga City 7000' },
  { id: 'ayala', name: 'Ayala District', lat: 6.9600, lon: 121.9540, address: 'Ayala Highway & Industrial Zone, Zamboanga City 7000' },
  { id: 'vitali', name: 'Vitali District', lat: 7.3200, lon: 122.2800, address: 'Vitali Coastal Highway, Zamboanga City 7000' },
];
---

<section class="py-14 sm:py-20 md:py-24 bg-gradient-to-b from-slate-50 via-white to-slate-50/80 font-sans border-t border-slate-100 relative overflow-hidden">
  
  <!-- Subtle Background Vinta Pattern Accent Blur -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-blue-400/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-amber-400/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 max-w-6xl relative z-10">
    
    <!-- Section Header Block -->
    <div class="text-center max-w-3xl mx-auto mb-10 sm:mb-14">
      
      <!-- Colorful Vinta Theme Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900 text-white text-xs font-bold mb-4 shadow-md border border-slate-800">
        <!-- Vinta Color Ribbon Accent Dots -->
        <span class="flex items-center gap-1">
          <span class="w-2 h-2 rounded-full bg-[#c084fc]"></span>
          <span class="w-2 h-2 rounded-full bg-[#38bdf8]"></span>
          <span class="w-2 h-2 rounded-full bg-[#4ade80]"></span>
          <span class="w-2 h-2 rounded-full bg-[#fca5a5]"></span>
          <span class="w-2 h-2 rounded-full bg-[#fbbf24]"></span>
        </span>
        <span class="tracking-wide">Asia's Latin City · Real-Time Portal</span>
      </div>

      <!-- Main Section Title matching user reference -->
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight mb-3.5">
        Weather and Map of <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-indigo-600 to-amber-500">Zamboanga City</span>
      </h2>

      <!-- Subtitle -->
      <p class="text-slate-600 text-sm sm:text-base font-normal leading-relaxed max-w-xl mx-auto">
        Live weather forecast powered by Open-Meteo and interactive landmark map of Zamboanga City
      </p>

      <!-- Location Selector Chips / Pills -->
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2" id="zambo-district-selector">
        {locations.map((loc, idx) => (
          <button
            type="button"
            data-lat={loc.lat}
            data-lon={loc.lon}
            data-name={loc.name}
            data-address={loc.address}
            class={`district-chip px-3.5 py-1.5 rounded-full text-xs font-bold transition-all duration-200 cursor-pointer ${
              idx === 0
                ? 'bg-blue-600 text-white shadow-md shadow-blue-500/20 ring-2 ring-blue-600/30'
                : 'bg-white text-slate-700 hover:bg-slate-100 border border-slate-200'
            }`}
          >
            {loc.name}
          </button>
        ))}
      </div>
    </div>

    <!-- 2 Column Grid: Weather Left, Map Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      
      <!-- Weather Widget Column (Left) -->
      <div class="lg:col-span-5 flex flex-col">
        <WeatherWidget
          city="Zamboanga City, Philippines"
          latitude={6.9214}
          longitude={122.0790}
        />
      </div>

      <!-- Map Widget Column (Right) -->
      <div class="lg:col-span-7 flex flex-col">
        <MapWidget
          cityHallAddress="Zamboanga City Hall, N.S. Valderrosa St, Zamboanga City 7000"
        />
      </div>

    </div>

  </div>
</section>

<script>
  function initDistrictSelector() {
    const chips = document.querySelectorAll('.district-chip');
    chips.forEach((btn) => {
      btn.addEventListener('click', () => {
        const lat = parseFloat(btn.getAttribute('data-lat') || '6.9214');
        const lon = parseFloat(btn.getAttribute('data-lon') || '122.0790');
        const name = btn.getAttribute('data-name') || 'Zamboanga City';
        const address = btn.getAttribute('data-address') || '';

        // Update active chip UI
        chips.forEach((c) => {
          c.classList.remove('bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-500/20', 'ring-2', 'ring-blue-600/30');
          c.classList.add('bg-white', 'text-slate-700', 'hover:bg-slate-100', 'border', 'border-slate-200');
        });
        btn.classList.remove('bg-white', 'text-slate-700', 'hover:bg-slate-100', 'border', 'border-slate-200');
        btn.classList.add('bg-blue-600', 'text-white', 'shadow-md', 'shadow-blue-500/20', 'ring-2', 'ring-blue-600/30');

        // Broadcast event to both WeatherWidget and MapWidget
        window.dispatchEvent(
          new CustomEvent('zambo-location-change', {
            detail: { lat, lon, name, address },
          })
        );
      });
    });
  }

  document.addEventListener('astro:page-load', initDistrictSelector);
  if (document.readyState !== 'loading') {
    initDistrictSelector();
  }
</script>
