---
import WeatherWidget from '../WeatherWidget.astro';
import MapWidget from '../MapWidget.astro';
---

<section class="py-12 sm:py-16 md:py-20 bg-gradient-to-b from-slate-50 via-white to-slate-50/80 font-sans border-t border-slate-100 relative overflow-hidden">
  
  <!-- Background Ambient Glow Accents -->
  <div class="absolute top-0 right-1/4 w-96 h-96 bg-blue-400/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 left-1/4 w-96 h-96 bg-amber-400/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 max-w-6xl relative z-10">
    
    <!-- 2 Column Grid: Weather Left, Map Right -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-stretch">
      
      <!-- Weather Widget Column (Left) -->
      <div class="lg:col-span-5 flex flex-col">
        <WeatherWidget
          city="Zamboanga City, Philippines"
          latitude={6.9214}
          longitude={122.0790}
        />
      </div>

      <!-- Map Widget Column (Right) -->
      <div class="lg:col-span-7 flex flex-col">
        <MapWidget
          cityHallAddress="Zamboanga City Hall, N.S. Valderrosa St, Zamboanga City 7000"
        />
      </div>

    </div>

  </div>
</section>
