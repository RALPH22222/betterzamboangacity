---

<Layout title="Disaster Preparedness & Emergency Directory | Better Zamboanga City" mainClass="grow bg-slate-50 font-sans pb-16">
  <!-- Leaflet CSS for OpenStreetMap -->
  <link
    rel="stylesheet"
    href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
    integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
    crossorigin=""
  />
    
    <!-- Breadcrumb & Main Header -->
    <div class="container mx-auto px-4 pt-8 pb-6 max-w-6xl">
      <nav class="text-xs font-semibold text-slate-500 mb-3 flex items-center gap-2">
        <a href="/" class="hover:text-blue-600 transition-colors">Home</a>
        <span>/</span>
        <span class="text-slate-900 font-bold">Disaster</span>
      </nav>

      <h1 class="text-3xl sm:text-5xl font-extrabold text-slate-900 tracking-tight mb-3">
        Disaster Preparedness
      </h1>
      <p class="text-slate-600 text-sm sm:text-base leading-relaxed max-w-3xl">
        Emergency hotlines, interactive facilities map, and step-by-step guidance for Zamboangueños.
      </p>
    </div>

    <div class="container mx-auto px-4 max-w-6xl space-y-8">
      
      <!-- TOP HERO EMERGENCY CALL BLOCK -->
      <div class="space-y-4">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">
          
          <!-- Main 911 Call Card -->
          <div class="lg:col-span-6 bg-gradient-to-br from-red-600 via-red-600 to-rose-700 text-white rounded-2xl p-7 sm:p-8 flex flex-col items-center justify-between text-center relative overflow-hidden shadow-md border border-red-700 group">
            <div class="absolute -right-12 -top-12 w-48 h-48 bg-white/10 rounded-full blur-2xl group-hover:scale-125 transition-transform duration-500"></div>
            
            <div class="relative z-10 flex flex-col items-center">
              <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 backdrop-blur-xs text-white text-xs font-semibold uppercase tracking-wider mb-4 border border-white/20">
                <span class="w-2 h-2 rounded-full bg-amber-300 animate-ping"></span>
                <span>National Emergency Hotline (24/7 Toll-Free)</span>
              </div>

              <div class="text-white mb-2 group-hover:scale-110 transition-transform duration-300">
                <svg class="w-12 h-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>

              <div class="text-4xl sm:text-5xl font-normal tracking-wide font-mono mb-2 text-white">
                911
              </div>
              <p class="text-red-100 text-xs sm:text-sm font-medium max-w-xs mb-6 leading-relaxed">
                Free emergency call from any mobile or landline across Zamboanga City & nationwide.
              </p>
            </div>

            <!-- Dual Action CTAs -->
            <div class="relative z-10 w-full flex items-center justify-center gap-3">
              <a
                href="tel:911"
                class="flex-1 py-3 px-5 rounded-xl bg-white text-red-700 hover:bg-red-50 font-bold text-sm sm:text-base shadow-xs hover:shadow transition-all flex items-center justify-center gap-2 focus:outline-none focus:ring-2 focus:ring-white"
              >
                <svg class="w-5 h-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>Call 911 Now</span>
              </a>
              <button
                type="button"
                data-copy-phone="911"
                class="p-3 rounded-xl bg-white/15 hover:bg-white/25 text-white backdrop-blur-xs transition-colors border border-white/20 focus:outline-none focus:ring-2 focus:ring-white shrink-0 cursor-pointer"
                title="Copy 911"
                aria-label="Copy 911"
              >
                <svg class="w-5 h-5 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <svg class="w-5 h-5 check-icon hidden text-amber-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                </svg>
              </button>
            </div>
          </div>

          <!-- 2x2 Quick Contact Grid Cards (Top-Aligned Flex Layout) -->
          <div class="lg:col-span-6 grid grid-cols-2 gap-3 items-start">
            
            <!-- RESCUE / CDRRMO -->
            <div class="bg-white border border-slate-200 hover:border-slate-400 rounded-xl p-4.5 flex flex-col justify-start gap-3 transition-all hover:shadow-xs group h-full">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-md uppercase tracking-wider">
                    Rescue / ZCDRRMO
                  </span>
                  <span class="text-[10px] text-slate-400 font-medium">Landline</span>
                </div>
                <div class="text-base sm:text-lg font-normal text-slate-800 font-mono tracking-wide my-1">
                  (062) 995-9601
                </div>
              </div>
              <div class="flex items-center gap-2 mt-auto pt-3 border-t border-slate-100">
                <a
                  href="tel:0629959601"
                  class="flex-1 py-1.5 px-2.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-medium text-xs flex items-center justify-center gap-1 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>Call</span>
                </a>
                <button
                  type="button"
                  data-copy-phone="(062) 995-9601"
                  class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-600 transition-colors cursor-pointer"
                  title="Copy number"
                  aria-label="Copy (062) 995-9601"
                >
                  <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <svg class="w-4 h-4 check-icon hidden text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- FIRE -->
            <div class="bg-white border border-slate-200 hover:border-slate-400 rounded-xl p-4.5 flex flex-col justify-start gap-3 transition-all hover:shadow-xs group h-full">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] font-bold text-red-700 bg-red-50 border border-red-200 px-2 py-0.5 rounded-md uppercase tracking-wider">
                    Fire Department
                  </span>
                  <span class="text-[10px] text-slate-400 font-medium">Shortcode</span>
                </div>
                <div class="text-base sm:text-lg font-normal text-slate-800 font-mono tracking-wide my-1">
                  160
                </div>
              </div>
              <div class="flex items-center gap-2 mt-auto pt-3 border-t border-slate-100">
                <a
                  href="tel:160"
                  class="flex-1 py-1.5 px-2.5 rounded-lg bg-red-600 hover:bg-red-700 text-white font-medium text-xs flex items-center justify-center gap-1 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>Call</span>
                </a>
                <button
                  type="button"
                  data-copy-phone="160"
                  class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-600 transition-colors cursor-pointer"
                  title="Copy number"
                  aria-label="Copy 160"
                >
                  <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <svg class="w-4 h-4 check-icon hidden text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- POLICE -->
            <div class="bg-white border border-slate-200 hover:border-slate-400 rounded-xl p-4.5 flex flex-col justify-start gap-3 transition-all hover:shadow-xs group h-full">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] font-bold text-blue-700 bg-blue-50 border border-blue-200 px-2 py-0.5 rounded-md uppercase tracking-wider">
                    Police / ZCPO
                  </span>
                  <span class="text-[10px] text-slate-400 font-medium">Mobile</span>
                </div>
                <div class="text-base sm:text-lg font-normal text-slate-800 font-mono tracking-wide my-1">
                  0977-855-8138
                </div>
              </div>
              <div class="flex items-center gap-2 mt-auto pt-3 border-t border-slate-100">
                <a
                  href="tel:09778558138"
                  class="flex-1 py-1.5 px-2.5 rounded-lg bg-blue-600 hover:bg-blue-700 text-white font-medium text-xs flex items-center justify-center gap-1 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>Call</span>
                </a>
                <button
                  type="button"
                  data-copy-phone="0977-855-8138"
                  class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-600 transition-colors cursor-pointer"
                  title="Copy number"
                  aria-label="Copy 0977-855-8138"
                >
                  <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <svg class="w-4 h-4 check-icon hidden text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </button>
              </div>
            </div>

            <!-- AMBULANCE -->
            <div class="bg-white border border-slate-200 hover:border-slate-400 rounded-xl p-4.5 flex flex-col justify-start gap-3 transition-all hover:shadow-xs group h-full">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="text-[10px] font-bold text-rose-700 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-md uppercase tracking-wider">
                    Ambulance / EMS
                  </span>
                  <span class="text-[10px] text-slate-400 font-medium">Landline</span>
                </div>
                <div class="text-base sm:text-lg font-normal text-slate-800 font-mono tracking-wide my-1">
                  (062) 926-1849
                </div>
              </div>
              <div class="flex items-center gap-2 mt-auto pt-3 border-t border-slate-100">
                <a
                  href="tel:0629261849"
                  class="flex-1 py-1.5 px-2.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-medium text-xs flex items-center justify-center gap-1 transition-colors"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                  <span>Call</span>
                </a>
                <button
                  type="button"
                  data-copy-phone="(062) 926-1849"
                  class="p-1.5 rounded-lg bg-slate-100 hover:bg-slate-200 border border-slate-200 text-slate-600 transition-colors cursor-pointer"
                  title="Copy number"
                  aria-label="Copy (062) 926-1849"
                >
                  <svg class="w-4 h-4 copy-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                  </svg>
                  <svg class="w-4 h-4 check-icon hidden text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
                  </svg>
                </button>
              </div>
            </div>

          </div>

        </div>
      </div>

      <!-- CLEAN EMERGENCY FACILITIES MAP SECTION (NO EMOJIS, NO AI SLOP) -->
      <section class="space-y-4 pt-2">
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-3">
          <div>
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
              Emergency Facilities Directory Map
            </h2>
            <p class="text-xs sm:text-sm text-slate-600 max-w-2xl mt-0.5">
              Locate hospitals, police precincts, fire substations, and disaster rescue centers across Zamboanga City with live directions.
            </p>
          </div>
          
          <button
            type="button"
            id="geo-locate-btn"
            class="inline-flex items-center justify-center gap-2 px-3.5 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-semibold transition-colors shadow-2xs shrink-0 cursor-pointer"
          >
            <svg class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Find Nearest Facility</span>
          </button>
        </div>

        <!-- Clean Card Container -->
        <div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-xs flex flex-col">
          
          <!-- Filter & Search Controls Bar -->
          <div class="bg-slate-50 p-3.5 border-b border-slate-200 flex flex-col md:flex-row md:items-center justify-between gap-3">
            
            <!-- Category Filter Pills (SVG Icons, No Emojis) -->
            <div class="flex items-center gap-1.5 overflow-x-auto text-xs" id="map-category-filters">
              
              <button type="button" data-map-filter="all" class="map-filter-btn px-3 py-1.5 rounded-lg bg-slate-900 text-white font-medium border border-slate-900 transition-colors whitespace-nowrap cursor-pointer flex items-center gap-1.5">
                <span>All Facilities (59)</span>
              </button>

              <button type="button" data-map-filter="hospital" class="map-filter-btn px-3 py-1.5 rounded-lg bg-white hover:bg-slate-100 text-slate-700 font-medium border border-slate-200 transition-colors whitespace-nowrap cursor-pointer flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-rose-600" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M19 10.5h-5.5V5h-3v5.5H5v3h5.5V19h3v-5.5H19v-3z"/>
                </svg>
