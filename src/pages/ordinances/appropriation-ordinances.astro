---
import Layout from '../../layouts/Layout.astro';
import OrdinanceExplorer from '../../components/ordinances/OrdinanceExplorer';
---

<Layout title="Appropriation Ordinances - Zamboanga City Ordinances" mainClass="grow bg-slate-50 font-sans pb-16">
  <main class="container mx-auto px-4 sm:px-6 py-8 sm:py-12 min-h-screen max-w-[1600px] w-full space-y-10">
    <!-- Page Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg bg-emerald-50 text-emerald-800 text-xs font-black uppercase tracking-wider border border-emerald-200 shadow-xs">
        Budget & Financial Allocations
      </span>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 tracking-tight leading-tight">
        Appropriation Ordinances
      </h1>
      <p class="text-base sm:text-lg text-slate-600 font-medium leading-relaxed">
        Explore city ordinances authorising municipal budgets, annual appropriations, supplemental funds, and public expenditure frameworks passed by the Sangguniang Panlungsod.
      </p>
    </div>

    <!-- Directory Table Component -->
    <OrdinanceExplorer client:load />
  </main>
</Layout>
