---
import Layout from '../../layouts/Layout.astro';
import BarangayHeader from '../../components/barangays/BarangayHeader.astro';
import BarangayExplorer from '../../components/barangays/BarangayExplorer';
---

<Layout title="98 Barangays Directory by District - Zamboanga City Barangays" mainClass="grow bg-slate-50 font-sans pb-16">
  <main class="container mx-auto px-4 sm:px-6 py-8 sm:py-12 min-h-screen max-w-[1600px] w-full space-y-10">
    <!-- Header & Educational Overview Banner (Matching Ordinance Page Design) -->
    <BarangayHeader />

    <!-- District 1 & District 2 Explorer Directory (React Interactive Component) -->
    <BarangayExplorer client:load />
  </main>
</Layout>
